# Pilloway deployment. Track the application, bundled plugin dependencies and site media.
# Store environment configuration, database exports and runtime files outside Git.
/license.txt
/readme.html
/wp-config.php
/wp-config.php.*
/wp-config-*.php
/web.config
/.user.ini
/php.ini
.env
.env.*
!/.env.example
auth.json
*.pem
*.key

# Database exports and local recovery files.
*.sql
*.sql.gz
*.sql.bz2
*.dump
*.bak
*.backup
*.old
*.orig
*.log
error_log

# Editor and build artifacts.
.DS_Store
Thumbs.db
*.swp
*~
.phpunit.cache/
node_modules/

# Local tooling and generated output.
/.pilloway-temp-*
/.playwright-cli/
/local-backups/
/docs/
/scripts/
/tests/
/output/

# WordPress runtime state and local tunnel helper.
/wp-content/uploads/wc-logs/
/wp-content/cache/
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/
/wp-content/ai1wm-backups/
/wp-content/updraft/
/wp-content/backups/
/wp-content/backup-db/
/wp-content/wflogs/
/wp-content/mu-plugins/quick-tunnel-preview.php
