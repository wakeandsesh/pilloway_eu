#. Plugin Name of the plugin
#: catcode-abandoned-cart-recovery-for-woocommerce.php
#: includes/Core/Privacy.php:153
msgid "CatCode Abandoned Cart Recovery for WooCommerce"
msgstr "CatCode Abandoned Cart Recovery for WooCommerce"

#. Description of the plugin
#: catcode-abandoned-cart-recovery-for-woocommerce.php
msgid "Captures abandoned WooCommerce carts and wins them back with a reminder email containing a one-click recovery link. Cart list with statistics, configurable timings and templates."
msgstr "Захоплює кинуті кошики WooCommerce і повертає покупців листом-нагадуванням із посиланням відновлення в один клік. Список кошиків зі статистикою, налаштовувані таймінги та шаблони."

#. Plugin URI of the plugin
#: catcode-abandoned-cart-recovery-for-woocommerce.php
msgid "https://catcode.com.ua/modules/catcode-abandoned-cart-recovery-for-woocommerce/"
msgstr "https://catcode.com.ua/modules/catcode-abandoned-cart-recovery-for-woocommerce/"

