{"translation-revision-date":"2026-07-13 12:00+0000","generator":"WP-CLI\/2.9.0","source":"build\/admin.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"uk","plural-forms":"nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);"},"Nova Post":["Nova Post"],"Nova Post Settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f Nova Post"],"All dimensions are required for each box and must be positive numbers.":["\u0414\u043b\u044f \u043a\u043e\u0436\u043d\u043e\u0457 \u043a\u043e\u0440\u043e\u0431\u043a\u0438 \u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u0456 \u0432\u0441\u0456 \u0440\u043e\u0437\u043c\u0456\u0440\u0438, \u0456 \u0432\u043e\u043d\u0438 \u043c\u0430\u044e\u0442\u044c \u0431\u0443\u0442\u0438 \u0434\u043e\u0434\u0430\u0442\u043d\u0438\u043c\u0438 \u0447\u0438\u0441\u043b\u0430\u043c\u0438."],"Division":["\u0412\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u043d\u044f"],"Address":["\u0410\u0434\u0440\u0435\u0441\u0430"],"Confirm Action":["\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u044c\u0442\u0435 \u0434\u0456\u044e"],"Do you want to continue?":["\u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438?"],"Settings saved successfully!":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e!"],"API configuration saved successfully!":["\u041a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u044e API \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e!"],"Save":["\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438"],"Information":["\u0406\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044f"],"Example":["\u041f\u0440\u0438\u043a\u043b\u0430\u0434"],"More information":["\u0414\u043e\u043a\u043b\u0430\u0434\u043d\u0456\u0448\u0435"],"API Configuration":["\u041a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u044f API"],"Production API Key":["\u0420\u043e\u0431\u043e\u0447\u0438\u0439 API-\u043a\u043b\u044e\u0447"],"Enter your live API key obtained from your NovaPost account. This key is used for creating actual shipments.":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0440\u043e\u0431\u043e\u0447\u0438\u0439 API-\u043a\u043b\u044e\u0447, \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u0438\u0439 \u0443 \u0432\u0430\u0448\u043e\u043c\u0443 \u0430\u043a\u0430\u0443\u043d\u0442\u0456 NovaPost. \u0426\u0435\u0439 \u043a\u043b\u044e\u0447 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u0438\u0445 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044c."],"Enter your Nova Post API key":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0441\u0432\u0456\u0439 API-\u043a\u043b\u044e\u0447 Nova Post"],"Testing API":["\u0422\u0435\u0441\u0442\u043e\u0432\u0438\u0439 API"],"Enable to use the NovaPost testing environment. This allows you to test the plugin's functionality without creating real shipments. Remember to disable this mode before launching your store for actual sales.":["\u0423\u0432\u0456\u043c\u043a\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0442\u0435\u0441\u0442\u043e\u0432\u0435 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0435 NovaPost. \u0426\u0435 \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0440\u043e\u0431\u043e\u0442\u0443 \u043f\u043b\u0430\u0433\u0456\u043d\u0430 \u0431\u0435\u0437 \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u0438\u0445 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044c. \u041d\u0435 \u0437\u0430\u0431\u0443\u0434\u044c\u0442\u0435 \u0432\u0438\u043c\u043a\u043d\u0443\u0442\u0438 \u0446\u0435\u0439 \u0440\u0435\u0436\u0438\u043c \u043f\u0435\u0440\u0435\u0434 \u0437\u0430\u043f\u0443\u0441\u043a\u043e\u043c \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0443 \u0434\u043b\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u0438\u0445 \u043f\u0440\u043e\u0434\u0430\u0436\u0456\u0432."],"Enable testing mode to use stage API key":["\u0423\u0432\u0456\u043c\u043a\u043d\u0456\u0442\u044c \u0442\u0435\u0441\u0442\u043e\u0432\u0438\u0439 \u0440\u0435\u0436\u0438\u043c, \u0449\u043e\u0431 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0442\u0435\u0441\u0442\u043e\u0432\u0438\u0439 API-\u043a\u043b\u044e\u0447"],"Stage API Key":["\u0422\u0435\u0441\u0442\u043e\u0432\u0438\u0439 API-\u043a\u043b\u044e\u0447"],"Enter your test API key obtained from the NovaPost Sandbox environment. Use it with the 'Testing API' option to safely test the plugin's functionality.":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0442\u0435\u0441\u0442\u043e\u0432\u0438\u0439 API-\u043a\u043b\u044e\u0447, \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u0438\u0439 \u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0456 NovaPost Sandbox. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0439\u043e\u0433\u043e \u0440\u0430\u0437\u043e\u043c \u0437 \u043e\u043f\u0446\u0456\u0454\u044e \u00ab\u0422\u0435\u0441\u0442\u043e\u0432\u0438\u0439 API\u00bb, \u0449\u043e\u0431 \u0431\u0435\u0437\u043f\u0435\u0447\u043d\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0440\u043e\u0431\u043e\u0442\u0443 \u043f\u043b\u0430\u0433\u0456\u043d\u0430."],"Enter your Stage Nova Post API key":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0441\u0432\u0456\u0439 \u0442\u0435\u0441\u0442\u043e\u0432\u0438\u0439 API-\u043a\u043b\u044e\u0447 Nova Post"],"Contract Numbers":["\u041d\u043e\u043c\u0435\u0440\u0438 \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0456\u0432"],"Domestic Contract Number":["\u041d\u043e\u043c\u0435\u0440 \u0432\u043d\u0443\u0442\u0440\u0456\u0448\u043d\u044c\u043e\u0433\u043e \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0443"],"Enter your contract number for shipments within one country.":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043d\u043e\u043c\u0435\u0440 \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0443 \u0434\u043b\u044f \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044c \u0443 \u043c\u0435\u0436\u0430\u0445 \u043e\u0434\u043d\u0456\u0454\u0457 \u043a\u0440\u0430\u0457\u043d\u0438."],"Enter domestic contract number":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043d\u043e\u043c\u0435\u0440 \u0432\u043d\u0443\u0442\u0440\u0456\u0448\u043d\u044c\u043e\u0433\u043e \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0443"],"International Contract Number":["\u041d\u043e\u043c\u0435\u0440 \u043c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0443"],"Enter your contract number for international shipments outside the country of departure and the EU.":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043d\u043e\u043c\u0435\u0440 \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0443 \u0434\u043b\u044f \u043c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u0438\u0445 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044c \u0437\u0430 \u043c\u0435\u0436\u0456 \u043a\u0440\u0430\u0457\u043d\u0438 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0442\u0430 \u0404\u0421."],"Enter international contract number":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043d\u043e\u043c\u0435\u0440 \u043c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0443"],"Failed to load countries":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u043a\u0440\u0430\u0457\u043d\u0438"],"Postal Code":["\u041f\u043e\u0448\u0442\u043e\u0432\u0438\u0439 \u0456\u043d\u0434\u0435\u043a\u0441"],"Street":["\u0412\u0443\u043b\u0438\u0446\u044f"],"Building":["\u0411\u0443\u0434\u0438\u043d\u043e\u043a"],"Failed to search divisions: %s":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u043d\u0430\u0439\u0442\u0438 \u0432\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u043d\u044f: %s"],"Country code is required":["\u041a\u043e\u0434 \u043a\u0440\u0430\u0457\u043d\u0438 \u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u0438\u0439"],"City is required":["\u041c\u0456\u0441\u0442\u043e \u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u0435"],"Search query is required":["\u041f\u043e\u0448\u0443\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0442 \u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u0438\u0439"],"Type must be either \"branch\" or \"postomat\"":["\u0422\u0438\u043f \u043c\u0430\u0454 \u0431\u0443\u0442\u0438 \"branch\" \u0430\u0431\u043e \"postomat\""],"Enter division name":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043d\u0430\u0437\u0432\u0443 \u0432\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u043d\u044f"],"No divisions found":["\u0412\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u044c \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e"],"Error loading divisions":["\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0432\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u044c"],"Sender Data":["\u0414\u0430\u043d\u0456 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043d\u0438\u043a\u0430"],"First Name":["\u0406\u043c'\u044f"],"Enter first name":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0456\u043c'\u044f"],"Last Name":["\u041f\u0440\u0456\u0437\u0432\u0438\u0449\u0435"],"Enter last name":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043f\u0440\u0456\u0437\u0432\u0438\u0449\u0435"],"Email":["Email"],"Enter email address":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0443 \u0430\u0434\u0440\u0435\u0441\u0443"],"Phone":["\u0422\u0435\u043b\u0435\u0444\u043e\u043d"],"Enter phone number":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443"],"Company TIN":["\u0406\u041f\u041d \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0457"],"Enter your company's Taxpayer Identification Number.":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u0439\u043d\u0438\u0439 \u043d\u043e\u043c\u0435\u0440 \u043f\u043b\u0430\u0442\u043d\u0438\u043a\u0430 \u043f\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0432\u0430\u0448\u043e\u0457 \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0457."],"Enter company TIN":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0406\u041f\u041d \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0457"],"Company Name":["\u041d\u0430\u0437\u0432\u0430 \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0457"],"Enter the full legal name of your company as specified in the registration documents.":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043f\u043e\u0432\u043d\u0443 \u044e\u0440\u0438\u0434\u0438\u0447\u043d\u0443 \u043d\u0430\u0437\u0432\u0443 \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0457, \u044f\u043a \u0437\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043e \u0432 \u0440\u0435\u0454\u0441\u0442\u0440\u0430\u0446\u0456\u0439\u043d\u0438\u0445 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0445."],"Enter company name":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043d\u0430\u0437\u0432\u0443 \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0457"],"EORI Code":["EORI-\u043a\u043e\u0434"],"Enter your EORI (Economic Operators Registration and Identification) number. It is mandatory for all companies engaged in importing or exporting goods within the European Union.":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0441\u0432\u0456\u0439 \u043d\u043e\u043c\u0435\u0440 EORI (Economic Operators Registration and Identification). \u0412\u0456\u043d \u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u0438\u0439 \u0434\u043b\u044f \u0432\u0441\u0456\u0445 \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0439, \u044f\u043a\u0456 \u0456\u043c\u043f\u043e\u0440\u0442\u0443\u044e\u0442\u044c \u0430\u0431\u043e \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0443\u044e\u0442\u044c \u0442\u043e\u0432\u0430\u0440\u0438 \u0432 \u043c\u0435\u0436\u0430\u0445 \u0404\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u044c\u043a\u043e\u0433\u043e \u0421\u043e\u044e\u0437\u0443."],"Enter EORI code":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c EORI-\u043a\u043e\u0434"],"IOSS":["IOSS"],"Enter your IOSS (Import One-Stop Shop) number if you are registered in this system. It is used to simplify VAT payments on sales of goods up to 150 EUR to buyers in the EU.":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0441\u0432\u0456\u0439 \u043d\u043e\u043c\u0435\u0440 IOSS (Import One-Stop Shop), \u044f\u043a\u0449\u043e \u0432\u0438 \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u043e\u0432\u0430\u043d\u0456 \u0432 \u0446\u0456\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0456. \u0412\u0456\u043d \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u0441\u043f\u0440\u043e\u0449\u0435\u043d\u043d\u044f \u0441\u043f\u043b\u0430\u0442\u0438 \u041f\u0414\u0412 \u043f\u0456\u0434 \u0447\u0430\u0441 \u043f\u0440\u043e\u0434\u0430\u0436\u0443 \u0442\u043e\u0432\u0430\u0440\u0456\u0432 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044e \u0434\u043e 150 EUR \u043f\u043e\u043a\u0443\u043f\u0446\u044f\u043c \u0443 \u0404\u0421."],"Enter IOSS":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c IOSS"],"Shipment Departure Method":["\u0421\u043f\u043e\u0441\u0456\u0431 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f"],"Configure your shipment departure method. Fill in the address fields if you want a courier to pick up shipments from your address (Pickup service). Select a division in the widget if you will bring the parcels yourself.":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0439\u0442\u0435 \u0441\u043f\u043e\u0441\u0456\u0431 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f. \u0417\u0430\u043f\u043e\u0432\u043d\u0456\u0442\u044c \u043f\u043e\u043b\u044f \u0430\u0434\u0440\u0435\u0441\u0438, \u044f\u043a\u0449\u043e \u0445\u043e\u0447\u0435\u0442\u0435, \u0449\u043e\u0431 \u043a\u0443\u0440'\u0454\u0440 \u0437\u0430\u0431\u0438\u0440\u0430\u0432 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0437 \u0432\u0430\u0448\u043e\u0457 \u0430\u0434\u0440\u0435\u0441\u0438 (\u043f\u043e\u0441\u043b\u0443\u0433\u0430 \u0432\u0438\u043a\u043b\u0438\u043a\u0443 \u043a\u0443\u0440'\u0454\u0440\u0430). \u041e\u0431\u0435\u0440\u0456\u0442\u044c \u0432\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u043d\u044f \u0443 \u0432\u0456\u0434\u0436\u0435\u0442\u0456, \u044f\u043a\u0449\u043e \u043f\u0440\u0438\u0432\u043e\u0437\u0438\u0442\u0438\u043c\u0435\u0442\u0435 \u043f\u043e\u0441\u0438\u043b\u043a\u0438 \u0441\u0430\u043c\u043e\u0441\u0442\u0456\u0439\u043d\u043e."],"International Shipment Settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u0438\u0445 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044c"],"Configure customs fee payer and delivery tariff for shipments from Ukraine.":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0439\u0442\u0435 \u043f\u043b\u0430\u0442\u043d\u0438\u043a\u0430 \u043c\u0438\u0442\u043d\u0438\u0445 \u0437\u0431\u043e\u0440\u0456\u0432 \u0456 \u0442\u0430\u0440\u0438\u0444 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0434\u043b\u044f \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044c \u0437 \u0423\u043a\u0440\u0430\u0457\u043d\u0438."],"Customs Fee Payer":["\u041f\u043b\u0430\u0442\u043d\u0438\u043a \u043c\u0438\u0442\u043d\u0438\u0445 \u0437\u0431\u043e\u0440\u0456\u0432"],"Who pays customs fees for shipments. The sender may be automatically switched to the recipient as the customs fee payer if the declared parcel value exceeds the limit set for the recipient's country. If the value is below that country's minimum threshold, customs fees do not apply at all.":["\u0425\u0442\u043e \u0441\u043f\u043b\u0430\u0447\u0443\u0454 \u043c\u0438\u0442\u043d\u0456 \u0437\u0431\u043e\u0440\u0438 \u0437\u0430 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f. \u0412\u0456\u0434\u043f\u0440\u0430\u0432\u043d\u0438\u043a\u0430 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0437\u043c\u0456\u043d\u0435\u043d\u043e \u043d\u0430 \u043e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0447\u0430 \u044f\u043a \u043f\u043b\u0430\u0442\u043d\u0438\u043a\u0430 \u043c\u0438\u0442\u043d\u0438\u0445 \u0437\u0431\u043e\u0440\u0456\u0432, \u044f\u043a\u0449\u043e \u043e\u0433\u043e\u043b\u043e\u0448\u0435\u043d\u0430 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u043f\u043e\u0441\u0438\u043b\u043a\u0438 \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0443\u0454 \u043b\u0456\u043c\u0456\u0442, \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0439 \u0434\u043b\u044f \u043a\u0440\u0430\u0457\u043d\u0438 \u043e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0447\u0430. \u042f\u043a\u0449\u043e \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u043d\u0438\u0436\u0447\u0430 \u0437\u0430 \u043c\u0456\u043d\u0456\u043c\u0430\u043b\u044c\u043d\u0438\u0439 \u043f\u043e\u0440\u0456\u0433 \u0446\u0456\u0454\u0457 \u043a\u0440\u0430\u0457\u043d\u0438, \u043c\u0438\u0442\u043d\u0456 \u0437\u0431\u043e\u0440\u0438 \u0432\u0437\u0430\u0433\u0430\u043b\u0456 \u043d\u0435 \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f."],"Delivery Tariff":["\u0422\u0430\u0440\u0438\u0444 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"],"Field for selecting the type of delivery. Available values: \"Standard\" - regular delivery for all countries, and \"Express\" - fast international delivery available only for shipments to the USA. For other countries, \"Standard\" will be applied automatically. For shipments to the USA, when the recipient pays customs fees, only \"Express\" is applied.":["\u041f\u043e\u043b\u0435 \u0434\u043b\u044f \u0432\u0438\u0431\u043e\u0440\u0443 \u0442\u0438\u043f\u0443 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438. \u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0456 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f: \"Standard\" - \u0437\u0432\u0438\u0447\u0430\u0439\u043d\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0434\u043b\u044f \u0432\u0441\u0456\u0445 \u043a\u0440\u0430\u0457\u043d, \u0456 \"Express\" - \u0448\u0432\u0438\u0434\u043a\u0430 \u043c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430, \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u043b\u0438\u0448\u0435 \u0434\u043b\u044f \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044c \u0434\u043e \u0421\u0428\u0410. \u0414\u043b\u044f \u0456\u043d\u0448\u0438\u0445 \u043a\u0440\u0430\u0457\u043d \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \"Standard\". \u0414\u043b\u044f \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044c \u0434\u043e \u0421\u0428\u0410, \u043a\u043e\u043b\u0438 \u043c\u0438\u0442\u043d\u0456 \u0437\u0431\u043e\u0440\u0438 \u0441\u043f\u043b\u0430\u0447\u0443\u0454 \u043e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0447, \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u043b\u0438\u0448\u0435 \"Express\"."],"Standard":["\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442"],"Express":["\u0415\u043a\u0441\u043f\u0440\u0435\u0441"],"Country":["\u041a\u0440\u0430\u0457\u043d\u0430"],"Error loading countries":["\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u043a\u0440\u0430\u0457\u043d"],"Enter Country":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043a\u0440\u0430\u0457\u043d\u0443"],"City":["\u041c\u0456\u0441\u0442\u043e"],"Carrier shipping calculation":["\u0420\u043e\u0437\u0440\u0430\u0445\u0443\u043d\u043e\u043a \u0432\u0430\u0440\u0442\u043e\u0441\u0442\u0456 \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u043e\u043c"],"Carrier calculation":["\u0420\u043e\u0437\u0440\u0430\u0445\u0443\u043d\u043e\u043a \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0430"],"Shipping Flat Rate":["\u0424\u0456\u043a\u0441\u043e\u0432\u0430\u043d\u0430 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"],"Enter a fixed cost that will be displayed to the buyer. The actual shipping costs will be calculated via the API and charged to your account.":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0444\u0456\u043a\u0441\u043e\u0432\u0430\u043d\u0443 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044c, \u044f\u043a\u0443 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u044c \u043f\u043e\u043a\u0443\u043f\u0435\u0446\u044c. \u0424\u0430\u043a\u0442\u0438\u0447\u043d\u0430 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0431\u0443\u0434\u0435 \u0440\u043e\u0437\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u0430 \u0447\u0435\u0440\u0435\u0437 API \u0442\u0430 \u0441\u043f\u0438\u0441\u0430\u043d\u0430 \u0437 \u0432\u0430\u0448\u043e\u0433\u043e \u0440\u0430\u0445\u0443\u043d\u043a\u0443."],"Free Delivery for orders above":["\u0411\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0434\u043b\u044f \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u044c \u0432\u0456\u0434"],"Specify the order amount above which shipping will be free for the buyer. The actual shipping costs will be charged to your account":["\u0412\u043a\u0430\u0436\u0456\u0442\u044c \u0441\u0443\u043c\u0443 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f, \u0432\u0438\u0449\u0435 \u044f\u043a\u043e\u0457 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0431\u0443\u0434\u0435 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u043e\u044e \u0434\u043b\u044f \u043f\u043e\u043a\u0443\u043f\u0446\u044f. \u0424\u0430\u043a\u0442\u0438\u0447\u043d\u0430 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0431\u0443\u0434\u0435 \u0441\u043f\u0438\u0441\u0430\u043d\u0430 \u0437 \u0432\u0430\u0448\u043e\u0433\u043e \u0440\u0430\u0445\u0443\u043d\u043a\u0443"],"Product Information":["\u0406\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044f \u043f\u0440\u043e \u0442\u043e\u0432\u0430\u0440"],"Default product weight (kg)":["\u0422\u0438\u043f\u043e\u0432\u0430 \u0432\u0430\u0433\u0430 \u0442\u043e\u0432\u0430\u0440\u0443 (\u043a\u0433)"],"This weight will be used for all products that do not have the 'Weight' field filled in on the product page.":["\u0426\u044f \u0432\u0430\u0433\u0430 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438\u043c\u0435\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u0432\u0441\u0456\u0445 \u0442\u043e\u0432\u0430\u0440\u0456\u0432, \u0443 \u044f\u043a\u0438\u0445 \u043d\u0430 \u0441\u0442\u043e\u0440\u0456\u043d\u0446\u0456 \u0442\u043e\u0432\u0430\u0440\u0443 \u043d\u0435 \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u043e \u043f\u043e\u043b\u0435 \u00ab\u0412\u0430\u0433\u0430\u00bb."],"Default product dimensions":["\u0422\u0438\u043f\u043e\u0432\u0456 \u0440\u043e\u0437\u043c\u0456\u0440\u0438 \u0442\u043e\u0432\u0430\u0440\u0443"],"Dimensions for each product are first taken from its WooCommerce settings. If they are missing, the default dimensions will be used for the shipping calculation.":["\u0420\u043e\u0437\u043c\u0456\u0440\u0438 \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u0442\u043e\u0432\u0430\u0440\u0443 \u0441\u043f\u0435\u0440\u0448\u0443 \u0431\u0435\u0440\u0443\u0442\u044c\u0441\u044f \u0437 \u0439\u043e\u0433\u043e \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c WooCommerce. \u042f\u043a\u0449\u043e \u0457\u0445 \u043d\u0435\u043c\u0430\u0454, \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u0430\u0445\u0443\u043d\u043a\u0443 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u0442\u0438\u043f\u043e\u0432\u0456 \u0440\u043e\u0437\u043c\u0456\u0440\u0438."],"Length (cm)":["\u0414\u043e\u0432\u0436\u0438\u043d\u0430 (\u0441\u043c)"],"Width (cm)":["\u0428\u0438\u0440\u0438\u043d\u0430 (\u0441\u043c)"],"Height (cm)":["\u0412\u0438\u0441\u043e\u0442\u0430 (\u0441\u043c)"],"Default hs code":["\u0422\u0438\u043f\u043e\u0432\u0438\u0439 HS-\u043a\u043e\u0434"],"This code will be used for all goods in international shipments that do not have an individual HS-code. ":["\u0426\u0435\u0439 \u043a\u043e\u0434 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438\u043c\u0435\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u0432\u0441\u0456\u0445 \u0442\u043e\u0432\u0430\u0440\u0456\u0432 \u0443 \u043c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u0438\u0445 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f\u0445, \u044f\u043a\u0456 \u043d\u0435 \u043c\u0430\u044e\u0442\u044c \u0456\u043d\u0434\u0438\u0432\u0456\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e HS-\u043a\u043e\u0434\u0443. "],"8517120000 (for mobile phones)":["8517120000 (\u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456\u0432)"],"Enter default HS tariff code":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0442\u0438\u043f\u043e\u0432\u0438\u0439 HS-\u043a\u043e\u0434"],"Box %d":["\u041a\u043e\u0440\u043e\u0431\u043a\u0430 %d"],"L":["\u0414"],"cm":["\u0441\u043c"],"W":["\u0428"],"H":["\u0412"],"Remove box":["\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u043a\u043e\u0440\u043e\u0431\u043a\u0443"],"Add Box":["\u0414\u043e\u0434\u0430\u0442\u0438 \u043a\u043e\u0440\u043e\u0431\u043a\u0443"],"At least one custom box with valid dimensions is required.":["\u041f\u043e\u0442\u0440\u0456\u0431\u043d\u0430 \u0449\u043e\u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0435 \u043e\u0434\u043d\u0430 \u0432\u043b\u0430\u0441\u043d\u0430 \u043a\u043e\u0440\u043e\u0431\u043a\u0430 \u0437 \u043a\u043e\u0440\u0435\u043a\u0442\u043d\u0438\u043c\u0438 \u0440\u043e\u0437\u043c\u0456\u0440\u0430\u043c\u0438."],"You can define up to 10 custom boxes. At least one box is required.":["\u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u0434\u0430\u0442\u0438 \u0434\u043e 10 \u0432\u043b\u0430\u0441\u043d\u0438\u0445 \u043a\u043e\u0440\u043e\u0431\u043e\u043a. \u041f\u043e\u0442\u0440\u0456\u0431\u043d\u0430 \u0449\u043e\u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0435 \u043e\u0434\u043d\u0430."],"Packaging Settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0430\u043a\u0443\u0432\u0430\u043d\u043d\u044f"],"Packaging type":["\u0422\u0438\u043f \u043f\u0430\u043a\u0443\u0432\u0430\u043d\u043d\u044f"],"Nova Post boxes uses predefined standard sizes with optimal packing. One box uses fixed dimensions for entire order. Custom boxes allows you to define up to 10 box sizes.":["\u00ab\u041a\u043e\u0440\u043e\u0431\u043a\u0438 Nova Post\u00bb \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0456 \u0440\u043e\u0437\u043c\u0456\u0440\u0438 \u0437 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u0438\u043c \u043f\u0430\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c. \u00ab\u041e\u0434\u043d\u0430 \u043a\u043e\u0440\u043e\u0431\u043a\u0430 \u043d\u0430 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f\u00bb \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u0444\u0456\u043a\u0441\u043e\u0432\u0430\u043d\u0456 \u0440\u043e\u0437\u043c\u0456\u0440\u0438 \u0434\u043b\u044f \u0432\u0441\u044c\u043e\u0433\u043e \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f. \u00ab\u0412\u043b\u0430\u0441\u043d\u0456 \u043a\u043e\u0440\u043e\u0431\u043a\u0438\u00bb \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442\u044c \u0437\u0430\u0434\u0430\u0442\u0438 \u0434\u043e 10 \u0440\u043e\u0437\u043c\u0456\u0440\u0456\u0432."],"Use Nova Post boxes":["\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u0440\u043e\u0431\u043a\u0438 Nova Post"],"One box per order":["\u041e\u0434\u043d\u0430 \u043a\u043e\u0440\u043e\u0431\u043a\u0430 \u043d\u0430 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f"],"Use custom boxes":["\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0456 \u043a\u043e\u0440\u043e\u0431\u043a\u0438"],"Cash on Delivery":["\u041f\u0456\u0441\u043b\u044f\u043f\u043b\u0430\u0442\u0430"],"COD fee is paid by the seller":["\u041a\u043e\u043c\u0456\u0441\u0456\u044e \u0437\u0430 \u043f\u0456\u0441\u043b\u044f\u043f\u043b\u0430\u0442\u0443 \u0441\u043f\u043b\u0430\u0447\u0443\u0454 \u043f\u0440\u043e\u0434\u0430\u0432\u0435\u0446\u044c"],"Choose who pays the commission for the cash on delivery service. If off, the commission will be added to the total amount the buyer has to pay. If on, the buyer will only pay for the goods and their delivery.":["\u041e\u0431\u0435\u0440\u0456\u0442\u044c, \u0445\u0442\u043e \u0441\u043f\u043b\u0430\u0447\u0443\u0454 \u043a\u043e\u043c\u0456\u0441\u0456\u044e \u0437\u0430 \u043f\u043e\u0441\u043b\u0443\u0433\u0443 \u043f\u0456\u0441\u043b\u044f\u043f\u043b\u0430\u0442\u0438. \u042f\u043a\u0449\u043e \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e, \u043a\u043e\u043c\u0456\u0441\u0456\u044e \u0431\u0443\u0434\u0435 \u0434\u043e\u0434\u0430\u043d\u043e \u0434\u043e \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u0457 \u0441\u0443\u043c\u0438, \u044f\u043a\u0443 \u0441\u043f\u043b\u0430\u0447\u0443\u0454 \u043f\u043e\u043a\u0443\u043f\u0435\u0446\u044c. \u042f\u043a\u0449\u043e \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e, \u043f\u043e\u043a\u0443\u043f\u0435\u0446\u044c \u0441\u043f\u043b\u0430\u0442\u0438\u0442\u044c \u043b\u0438\u0448\u0435 \u0437\u0430 \u0442\u043e\u0432\u0430\u0440 \u0456 \u0439\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0443."],"This setting must be agreed at the contract level.":["\u0426\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043c\u0430\u0454 \u0431\u0443\u0442\u0438 \u043f\u043e\u0433\u043e\u0434\u0436\u0435\u043d\u0435 \u043d\u0430 \u0440\u0456\u0432\u043d\u0456 \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0443."],"Bank Account Id":["\u0406\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u043e\u0440 \u0431\u0430\u043d\u043a\u0456\u0432\u0441\u044c\u043a\u043e\u0433\u043e \u0440\u0430\u0445\u0443\u043d\u043a\u0443"],"Enter your bank account's unique identifier provided by your bank for crediting funds for cash on delivery.":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0443\u043d\u0456\u043a\u0430\u043b\u044c\u043d\u0438\u0439 \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u043e\u0440 \u0431\u0430\u043d\u043a\u0456\u0432\u0441\u044c\u043a\u043e\u0433\u043e \u0440\u0430\u0445\u0443\u043d\u043a\u0443, \u043d\u0430\u0434\u0430\u043d\u0438\u0439 \u0432\u0430\u0448\u0438\u043c \u0431\u0430\u043d\u043a\u043e\u043c \u0434\u043b\u044f \u0437\u0430\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043e\u0448\u0442\u0456\u0432 \u0437\u0430 \u043f\u0456\u0441\u043b\u044f\u043f\u043b\u0430\u0442\u043e\u044e."],"Enter your Bank Account Id":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u043e\u0440 \u0431\u0430\u043d\u043a\u0456\u0432\u0441\u044c\u043a\u043e\u0433\u043e \u0440\u0430\u0445\u0443\u043d\u043a\u0443"],"Bank Account Name or IBAN":["\u041d\u0430\u0437\u0432\u0430 \u0431\u0430\u043d\u043a\u0456\u0432\u0441\u044c\u043a\u043e\u0433\u043e \u0440\u0430\u0445\u0443\u043d\u043a\u0443 \u0430\u0431\u043e IBAN"],"Enter your bank name or account number in IBAN format to transfer funds for cash on delivery.":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043d\u0430\u0437\u0432\u0443 \u0431\u0430\u043d\u043a\u0443 \u0430\u0431\u043e \u043d\u043e\u043c\u0435\u0440 \u0440\u0430\u0445\u0443\u043d\u043a\u0443 \u0443 \u0444\u043e\u0440\u043c\u0430\u0442\u0456 IBAN \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u043a\u0430\u0437\u0443 \u043a\u043e\u0448\u0442\u0456\u0432 \u0437\u0430 \u043f\u0456\u0441\u043b\u044f\u043f\u043b\u0430\u0442\u043e\u044e."],"Enter your Bank Account Name":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043d\u0430\u0437\u0432\u0443 \u0431\u0430\u043d\u043a\u0456\u0432\u0441\u044c\u043a\u043e\u0433\u043e \u0440\u0430\u0445\u0443\u043d\u043a\u0443"],"Order Workflow":["\u0420\u043e\u0431\u043e\u0447\u0438\u0439 \u043f\u0440\u043e\u0446\u0435\u0441 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u044c"],"Auto-complete orders":["\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0432\u0438\u043a\u043e\u043d\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f"],"Automatically change order status to \u2018Completed' after creating a waybill. This triggers the standard email notification with tracking details to the customer.":["\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0437\u043c\u0456\u043d\u044e\u0432\u0430\u0442\u0438 \u0441\u0442\u0430\u0442\u0443\u0441 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043d\u0430 \u00ab\u0412\u0438\u043a\u043e\u043d\u0430\u043d\u043e\u00bb \u043f\u0456\u0441\u043b\u044f \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u043d\u0430\u043a\u043b\u0430\u0434\u043d\u043e\u0457. \u0426\u0435 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0454 \u043f\u043e\u043a\u0443\u043f\u0446\u044e \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0435 \u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u044e \u043f\u043e\u0448\u0442\u043e\u044e \u0437 \u0434\u0430\u043d\u0438\u043c\u0438 \u0434\u043b\u044f \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f."],"Divisions Filters":["\u0424\u0456\u043b\u044c\u0442\u0440\u0438 \u0432\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u044c"],"Allowed Divisions Types":["\u0414\u043e\u0437\u0432\u043e\u043b\u0435\u043d\u0456 \u0442\u0438\u043f\u0438 \u0432\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u044c"],"Post Branch":["\u041f\u043e\u0448\u0442\u043e\u0432\u0435 \u0432\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u043d\u044f"],"Pick Up Drop Off":["\u041f\u0443\u043d\u043a\u0442 \u0432\u0438\u0434\u0430\u0447\u0456"],"Sender":["\u0412\u0456\u0434\u043f\u0440\u0430\u0432\u043d\u0438\u043a"],"Recipient":["\u041e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0447"],"Parcel locker":["\u041f\u043e\u0448\u0442\u043e\u043c\u0430\u0442"],"Loading divisions\u2026":[""],"Select the branch types to display in the Nova Post widget on the checkout page. Customers will only see the branch types you have checked (Post Branch, Freight branch, Parcel locker, or Pick Up Drop Off).":["\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0442\u0438\u043f\u0438 \u0432\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u044c \u0434\u043b\u044f \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0443 \u0432\u0456\u0434\u0436\u0435\u0442\u0456 Nova Post \u043d\u0430 \u0441\u0442\u043e\u0440\u0456\u043d\u0446\u0456 \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f. \u041a\u043b\u0456\u0454\u043d\u0442\u0438 \u0431\u0430\u0447\u0438\u0442\u0438\u043c\u0443\u0442\u044c \u043b\u0438\u0448\u0435 \u043e\u0431\u0440\u0430\u043d\u0456 \u0442\u0438\u043f\u0438 (\u043f\u043e\u0448\u0442\u043e\u0432\u0435 \u0432\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u043d\u044f, \u0432\u0430\u043d\u0442\u0430\u0436\u043d\u0435 \u0432\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u043d\u044f, \u043f\u043e\u0448\u0442\u043e\u043c\u0430\u0442 \u0430\u0431\u043e \u043f\u0443\u043d\u043a\u0442 \u0432\u0438\u0434\u0430\u0447\u0456)."],"Freight branch":["\u0412\u0430\u043d\u0442\u0430\u0436\u043d\u0435 \u0432\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u043d\u044f"],"Loading data\u2026":[""]}}}