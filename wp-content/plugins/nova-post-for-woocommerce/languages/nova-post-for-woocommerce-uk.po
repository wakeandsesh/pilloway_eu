#: data/validator-messages.php:5
msgid "The :attribute field must be accepted."
msgstr "Поле :attribute має бути прийняте."

#: data/validator-messages.php:6
msgid "The :attribute field must be a date after :date."
msgstr "Поле :attribute має бути датою після :date."

#: data/validator-messages.php:7
msgid "The :attribute field must be a date after or equal to :date."
msgstr "Поле :attribute має бути датою після або рівною :date."

#: data/validator-messages.php:8
msgid "The :attribute field must only contain letters."
msgstr "Поле :attribute має містити лише літери."

#: data/validator-messages.php:9
msgid "The :attribute field must only contain letters, numbers, dashes, and underscores."
msgstr "Поле :attribute має містити лише літери, цифри, дефіси та підкреслення."

#: data/validator-messages.php:10
msgid "The :attribute field must only contain letters and numbers."
msgstr "Поле :attribute має містити лише літери та цифри."

#: data/validator-messages.php:11
msgid "The :attribute may only allows alphabet and spaces"
msgstr "Поле :attribute може містити лише літери та пробіли"

#: data/validator-messages.php:12
msgid "The :attribute field must be a date before :date."
msgstr "Поле :attribute має бути датою до :date."

#: data/validator-messages.php:13
msgid "The :attribute field must be between :min and :max."
msgstr "Поле :attribute має бути між :min і :max."

#: data/validator-messages.php:14
msgid "The :attribute field must be true or false."
msgstr "Поле :attribute має бути true або false."

#: data/validator-messages.php:15
msgid "The :attribute is not valid"
msgstr "Поле :attribute недійсне"

#: data/validator-messages.php:16
msgid "The :attribute field must be a valid date."
msgstr "Поле :attribute має бути коректною датою."

#: data/validator-messages.php:17
msgid "The :attribute default is :default"
msgstr "Значення :attribute за замовчуванням — :default"

#: data/validator-messages.php:18
msgid "The :attribute and :other must be different."
msgstr "Поля :attribute та :other мають відрізнятися."

#: data/validator-messages.php:19
msgid "The :attribute field must be :digits digits."
msgstr "Поле :attribute має містити :digits цифр."

#: data/validator-messages.php:20
msgid "The :attribute field must be between :min and :max digits."
msgstr "Поле :attribute має містити від :min до :max цифр."

#: data/validator-messages.php:21
msgid "The :attribute field must be a valid email address."
msgstr "Поле :attribute має бути коректною електронною адресою."

#: data/validator-messages.php:22
msgid "The :attribute must be a :allowed_extensions file"
msgstr "Поле :attribute має бути файлом типу :allowed_extensions"

#: data/validator-messages.php:23
msgid "The :attribute field must have a value."
msgstr "Поле :attribute має мати значення."

#: data/validator-messages.php:24
#: data/validator-messages.php:34
msgid "The selected :attribute is invalid."
msgstr "Обране значення :attribute недійсне."

#: data/validator-messages.php:25
msgid "The :attribute field must be an integer."
msgstr "Поле :attribute має бути цілим числом."

#: data/validator-messages.php:26
msgid "The :attribute field must be a valid IP address."
msgstr "Поле :attribute має бути коректною IP-адресою."

#: data/validator-messages.php:27
msgid "The :attribute field must be a valid IPv4 address."
msgstr "Поле :attribute має бути коректною IPv4-адресою."

#: data/validator-messages.php:28
msgid "The :attribute field must be a valid IPv6 address."
msgstr "Поле :attribute має бути коректною IPv6-адресою."

#: data/validator-messages.php:29
msgid "The :attribute field must be a valid JSON string."
msgstr "Поле :attribute має бути коректним JSON-рядком."

#: data/validator-messages.php:30
msgid "The :attribute field must be lowercase."
msgstr "Поле :attribute має бути в нижньому регістрі."

#: data/validator-messages.php:31
msgid "The :attribute field must not be greater than :max."
msgstr "Поле :attribute не має перевищувати :max."

#: data/validator-messages.php:32
msgid "The :attribute field must be a file of type: :values."
msgstr "Поле :attribute має бути файлом типу: :values."

#: data/validator-messages.php:33
msgid "The :attribute field must be at least :min."
msgstr "Поле :attribute має бути щонайменше :min."

#: data/validator-messages.php:35
msgid "The :attribute field must be a number."
msgstr "Поле :attribute має бути числом."

#: data/validator-messages.php:36
msgid "The :attribute field must be present."
msgstr "Поле :attribute має бути присутнє."

#: data/validator-messages.php:37
msgid "The :attribute field format is invalid."
msgstr "Формат поля :attribute недійсний."

#: data/validator-messages.php:38
msgid "The :attribute field is required."
msgstr "Поле :attribute обов'язкове."

#: data/validator-messages.php:39
msgid "The :attribute field is required when :other is :value."
msgstr "Поле :attribute обов'язкове, коли :other дорівнює :value."

#: data/validator-messages.php:40
msgid "The :attribute is required"
msgstr "Поле :attribute обов'язкове"

#: data/validator-messages.php:41
msgid "The :attribute field is required unless :other is in :values."
msgstr "Поле :attribute обов'язкове, якщо :other не входить у :values."

#: data/validator-messages.php:42
msgid "The :attribute field is required when :values is present."
msgstr "Поле :attribute обов'язкове, коли :values присутнє."

#: data/validator-messages.php:43
msgid "The :attribute field is required when :values are present."
msgstr "Поле :attribute обов'язкове, коли :values присутні."

#: data/validator-messages.php:44
msgid "The :attribute field is required when :values is not present."
msgstr "Поле :attribute обов'язкове, коли :values відсутнє."

#: data/validator-messages.php:45
msgid "The :attribute field is required when none of :values are present."
msgstr "Поле :attribute обов'язкове, коли жодне з :values не присутнє."

#: data/validator-messages.php:46
msgid "The :attribute and :other must match."
msgstr "Поля :attribute та :other мають збігатися."

#: data/validator-messages.php:47
msgid "The :attribute field must be :size."
msgstr "Поле :attribute має дорівнювати :size."

#: data/validator-messages.php:48
msgid "The :attribute field must be an array."
msgstr "Поле :attribute має бути масивом."

#: data/validator-messages.php:49
msgid "The :attribute field must be a string."
msgstr "Поле :attribute має бути рядком."

#: data/validator-messages.php:50
msgid "The :attribute failed to upload."
msgstr "Не вдалося завантажити :attribute."

#: data/validator-messages.php:51
msgid "The :attribute field must be uppercase."
msgstr "Поле :attribute має бути у верхньому регістрі."

#: data/validator-messages.php:52
msgid "The :attribute field must be a valid URL."
msgstr "Поле :attribute має бути коректним URL."

