2\u043e\u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f %d \u0437\u0430\u0433\u0440\u043e\u0437.","\u0420\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u043e \u0430\u0432\u0442\u043e\u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f %d \u0437\u0430\u0433\u0440\u043e\u0437."],"%d%% complete":["%d%% \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e"],"Jetpack is reviewing your site for vulnerabilities and suspicious files. This usually takes a few minutes.":["Jetpack \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u0454 \u0432\u0430\u0448 \u0441\u0430\u0439\u0442 \u043d\u0430 \u043d\u0430\u044f\u0432\u043d\u0456\u0441\u0442\u044c \u0443\u0440\u0430\u0437\u043b\u0438\u0432\u043e\u0441\u0442\u0435\u0439 \u0442\u0430 \u043f\u0456\u0434\u043e\u0437\u0440\u0456\u043b\u0438\u0445 \u0444\u0430\u0439\u043b\u0456\u0432. \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0446\u0435 \u0437\u0430\u0439\u043c\u0430\u0454 \u043a\u0456\u043b\u044c\u043a\u0430 \u0445\u0432\u0438\u043b\u0438\u043d."],"Your scan will start shortly. You can leave this page open or come back later.":["\u0412\u0430\u0448\u0435 \u0441\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0440\u043e\u0437\u043f\u043e\u0447\u043d\u0435\u0442\u044c\u0441\u044f \u043d\u0430\u0439\u0431\u043b\u0438\u0436\u0447\u0438\u043c \u0447\u0430\u0441\u043e\u043c. \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u0446\u044e \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u043e\u044e \u0430\u0431\u043e \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f \u043f\u0456\u0437\u043d\u0456\u0448\u0435."],"Scanning your site\u2026":["\u0421\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0430\u0448\u043e\u0433\u043e \u0441\u0430\u0439\u0442\u0443..."],"Scan queued\u2026":["\u0421\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0432 \u0447\u0435\u0440\u0437\u0456\u2026"],"Scan now":["\u0421\u043a\u0430\u043d\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0440\u0430\u0437"],"Could not start the scan. Please try again.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438 \u0441\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."],"Scan started.":["\u0421\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u043e."],"By ignoring this threat you confirm that you have reviewed the detected code and assume the risks of keeping a potentially malicious file on your site.":["\u0406\u0433\u043d\u043e\u0440\u0443\u044e\u0447\u0438 \u0446\u044e \u0437\u0430\u0433\u0440\u043e\u0437\u0443, \u0432\u0438 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0443\u0454\u0442\u0435, \u0449\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u043b\u0438 \u0432\u0438\u044f\u0432\u043b\u0435\u043d\u0438\u0439 \u043a\u043e\u0434, \u0456 \u0431\u0435\u0440\u0435\u0442\u0435 \u043d\u0430 \u0441\u0435\u0431\u0435 \u0440\u0438\u0437\u0438\u043a\u0438, \u043f\u043e\u0432\u2019\u044f\u0437\u0430\u043d\u0456 \u0437\u0456 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f\u043c \u043f\u043e\u0442\u0435\u043d\u0446\u0456\u0439\u043d\u043e \u0448\u043a\u0456\u0434\u043b\u0438\u0432\u043e\u0433\u043e \u0444\u0430\u0439\u043b\u0443 \u043d\u0430 \u0432\u0430\u0448\u043e\u043c\u0443 \u0441\u0430\u0439\u0442\u0456."],"Jetpack will be ignoring the following threat:":["Jetpack \u0456\u0433\u043d\u043e\u0440\u0443\u0432\u0430\u0442\u0438\u043c\u0435 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0443 \u0437\u0430\u0433\u0440\u043e\u0437\u0443:"],"Failed to ignore threat. Please try again.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043f\u0440\u043e\u0456\u0433\u043d\u043e\u0440\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0433\u0440\u043e\u0437\u0443. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."],"Threat ignored.":["\u0417\u0430\u0433\u0440\u043e\u0437\u0443 \u043f\u0440\u043e\u0456\u0433\u043d\u043e\u0440\u043e\u0432\u0430\u043d\u043e."],"Fixing threat\u2026":["\u0412\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u0433\u0440\u043e\u0437\u0438\u2026"],"Jetpack will be fixing the following threat:":["Jetpack \u0432\u0438\u043f\u0440\u0430\u0432\u0435 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0443 \u0437\u0430\u0433\u0440\u043e\u0437\u0443:"],"Failed to fix threat. Please try again.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0432\u0438\u043f\u0440\u0430\u0432\u0438\u0442\u0438 \u0437\u0430\u0433\u0440\u043e\u0437\u0443. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."],"Threat fixed.":["\u0417\u0430\u0433\u0440\u043e\u0437\u0443 \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e."],"%1$d of %2$d threats fixed.":["%1$d \u0437 %2$d \u0437\u0430\u0433\u0440\u043e\u0437 \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e."],"Hang tight \u2014 Jetpack is applying the fixes. This usually takes a few moments.":["\u0417\u0430\u0447\u0435\u043a\u0430\u0439\u0442\u0435 \u0442\u0440\u0456\u0448\u043a\u0438 - Jetpack \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0454 \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f. \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0446\u0435 \u0437\u0430\u0439\u043c\u0430\u0454 \u043a\u0456\u043b\u044c\u043a\u0430 \u0445\u0432\u0438\u043b\u0438\u043d."],"Auto-fix all":["\u0412\u0438\u043f\u0440\u0430\u0432\u0438\u0442\u0438 \u0432\u0441\u0435 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e"],"Threats that cannot be auto-fixed will be skipped.":["\u0417\u0430\u0433\u0440\u043e\u0437\u0438, \u044f\u043a\u0456 \u043d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0432\u0438\u043f\u0440\u0430\u0432\u0438\u0442\u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e, \u0431\u0443\u0434\u0443\u0442\u044c \u043f\u0440\u043e\u043f\u0443\u0449\u0435\u043d\u0456."],"Jetpack Scan can auto-fix %d threat. Continue?":["Jetpack Scan \u043c\u043e\u0436\u0435 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0432\u0438\u043f\u0440\u0430\u0432\u0438\u0442\u0438 %d \u0437\u0430\u0433\u0440\u043e\u0437\u0443. \u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438?","Jetpack Scan \u043c\u043e\u0436\u0435 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0432\u0438\u043f\u0440\u0430\u0432\u0438\u0442\u0438 %d \u0437\u0430\u0433\u0440\u043e\u0437\u0438. \u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438?","Jetpack Scan \u043c\u043e\u0436\u0435 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0432\u0438\u043f\u0440\u0430\u0432\u0438\u0442\u0438 %d \u0437\u0430\u0433\u0440\u043e\u0437. \u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438?"],"Auto-fix complete":["\u0410\u0432\u0442\u043e\u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e"],"Fixing threats\u2026":["\u0412\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u0433\u0440\u043e\u0437\u2026"],"Auto-fix finished: %1$d fixed, %2$d not fixed.":["\u0410\u0432\u0442\u043e\u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e: %1$d \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430, %2$d \u043d\u0435 \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e.","\u0410\u0432\u0442\u043e\u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e: %1$d \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e, %2$d \u043d\u0435 \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e.","\u0410\u0432\u0442\u043e\u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e: %1$d \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e, %2$d \u043d\u0435 \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e."],"Couldn't check fix status. Please refresh and try again.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0441\u0442\u0430\u0442\u0443\u0441 \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043e\u043d\u043e\u0432\u0456\u0442\u044c \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443 \u0442\u0430 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."],"Auto-fix failed. Please try again.":["\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0430\u0432\u0442\u043e\u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."],"Threat details":["\u0414\u0435\u0442\u0430\u043b\u0456 \u0437\u0430\u0433\u0440\u043e\u0437\u0438"],"Unignore threat":["\u041f\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u0438 \u0456\u0433\u043d\u043e\u0440\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0433\u0440\u043e\u0437\u0443"],"Unignore":["\u0411\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u0456\u0433\u043d\u043e\u0440\u0443\u0432\u0430\u0442\u0438"],"Ignore threat":["\u0406\u0433\u043d\u043e\u0440\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0433\u0440\u043e\u0437\u0443"],"Fix threat":["\u0412\u0438\u043f\u0440\u0430\u0432\u0438\u0442\u0438 \u0437\u0430\u0433\u0440\u043e\u0437\u0443"],"Fixed On":["\u0412\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e"],"First Detected":["\u0412\u043f\u0435\u0440\u0448\u0435 \u0432\u0438\u044f\u0432\u043b\u0435\u043d\u043e"],"Signature":["\u041f\u0456\u0434\u043f\u0438\u0441"],"Severity":["\u0420\u0456\u0432\u0435\u043d\u044c \u0437\u0430\u0433\u0440\u043e\u0437\u0438"],"Extension":["\u0420\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u043d\u044f"],"History (%d)":["\u0406\u0441\u0442\u043e\u0440\u0456\u044f (%d)"],"Active threats (%d)":["\u0410\u043a\u0442\u0438\u0432\u043d\u0456 \u0437\u0430\u0433\u0440\u043e\u0437\u0438 (%d)"],"Filter threats by status":["\u0424\u0456\u043b\u044c\u0442\u0440\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0433\u0440\u043e\u0437\u0438 \u0437\u0430 \u0441\u0442\u0430\u0442\u0443\u0441\u043e\u043c"],"WordPress":["WordPress"],"Ignored":["\u0406\u0433\u043d\u043e\u0440\u043e\u0432\u0430\u043d\u0456"],"Severity label for issues rated below 3.\u0004Low":["\u041d\u0438\u0437\u044c\u043a\u0438\u0439"],"Severity label for issues rated between 3 and 5.\u0004High":["\u0412\u0438\u0441\u043e\u043a\u0438\u0439"],"Severity label for issues rated 5 or higher.\u0004Critical":["\u041a\u0440\u0438\u0442\u0438\u0447\u043d\u0438\u0439"],"An auto-fixer is in progress.":["\u0412\u0438\u043a\u043e\u043d\u0443\u0454\u0442\u044c\u0441\u044f \u0430\u0432\u0442\u043e\u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f."],"The auto-fixer is taking longer than expected.":["\u0410\u0432\u0442\u043e\u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0442\u0440\u0438\u0432\u0430\u0454 \u0434\u043e\u0432\u0448\u0435, \u043d\u0456\u0436 \u043e\u0447\u0456\u043a\u0443\u0432\u0430\u043b\u043e\u0441\u044f."],"An error occurred auto-fixing this threat.":["\u041f\u0456\u0434 \u0447\u0430\u0441 \u0430\u0432\u0442\u043e\u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0446\u0456\u0454\u0457 \u0437\u0430\u0433\u0440\u043e\u0437\u0438 \u0432\u0438\u043d\u0438\u043a\u043b\u0430 \u043f\u043e\u043c\u0438