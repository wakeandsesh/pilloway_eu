ur post. Footer links take their color from Default text.":["\u041f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u0443 \u0432\u0430\u0448\u043e\u043c\u0443 \u0437\u0430\u043f\u0438\u0441\u0456. \u041f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u0443 \u043d\u0438\u0436\u043d\u044c\u043e\u043c\u0443 \u043a\u043e\u043b\u043e\u043d\u0442\u0438\u0442\u0443\u043b\u0456 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c \u043a\u043e\u043b\u0456\u0440 \u0442\u0435\u043a\u0441\u0442\u0443 \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c."],"email design styles\u0004The default for the whole email: post body, byline and footer. Headings and buttons inherit anything you don\u2019t set for them.":["\u0417\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0434\u043b\u044f \u0432\u0441\u044c\u043e\u0433\u043e \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0433\u043e \u043b\u0438\u0441\u0442\u0430: \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u0439 \u0432\u043c\u0456\u0441\u0442 \u0437\u0430\u043f\u0438\u0441\u0443, \u0430\u0432\u0442\u043e\u0440 \u0456 \u043d\u0438\u0436\u043d\u0456\u0439 \u043a\u043e\u043b\u043e\u043d\u0442\u0438\u0442\u0443\u043b. \u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438 \u0442\u0430 \u043a\u043d\u043e\u043f\u043a\u0438 \u0443\u0441\u043f\u0430\u0434\u043a\u043e\u0432\u0443\u044e\u0442\u044c \u0443\u0441\u0456 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438, \u044f\u043a\u0456 \u0434\u043b\u044f \u043d\u0438\u0445 \u043d\u0435 \u0437\u0430\u0434\u0430\u043d\u043e."],"email design styles\u0004Default text":["\u0422\u0435\u043a\u0441\u0442 \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c"],"You\u2019ve tried to select a block that is part of a template that may be used in other emails. Would you like to edit the template?":["\u0412\u0438 \u0441\u043f\u0440\u043e\u0431\u0443\u0432\u0430\u043b\u0438 \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u0431\u043b\u043e\u043a, \u0449\u043e \u0454 \u0447\u0430\u0441\u0442\u0438\u043d\u043e\u044e \u0448\u0430\u0431\u043b\u043e\u043d\u0443, \u044f\u043a\u0438\u0439 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u0438\u0439 \u0432 \u0456\u043d\u0448\u0438\u0445 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0438\u0445 \u043b\u0438\u0441\u0442\u0430\u0445. \u0411\u0430\u0436\u0430\u0454\u0442\u0435 \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u0448\u0430\u0431\u043b\u043e\u043d?"],"Content validation failed.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0432\u043c\u0456\u0441\u0442."],"Justification":["\u0412\u0438\u0440\u0456\u0432\u043d\u044e\u0432\u0430\u043d\u043d\u044f"],"Justify items right":["\u0412\u0438\u0440\u0456\u0432\u043d\u044e\u0432\u0430\u043d\u043d\u044f \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0456\u0432 \u0437\u0430 \u043f\u0440\u0430\u0432\u0438\u043c \u043a\u0440\u0430\u0454\u043c"],"Justify items center":["\u0412\u0438\u0440\u0456\u0432\u043d\u044e\u0432\u0430\u043d\u043d\u044f \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0456\u0432 \u043f\u043e \u0446\u0435\u043d\u0442\u0440\u0443"],"Justify items left":["\u0412\u0438\u0440\u0456\u0432\u043d\u044f\u0442\u0438 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0438 \u0437\u0430 \u043b\u0456\u0432\u0438\u043c \u043a\u0440\u0430\u0454\u043c"],"Saving failed.":["\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u043d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f."],"Post published.":["\u0417\u0430\u043f\u0438\u0441 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u043e\u0432\u0430\u043d\u043e."],"Post updated.":["\u0417\u0430\u043f\u0438\u0441 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043e."],"Email saved.":