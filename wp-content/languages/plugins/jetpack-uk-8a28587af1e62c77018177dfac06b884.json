],"Font family":["\u0421\u0456\u043c\u0435\u0439\u0441\u0442\u0432\u043e \u0448\u0440\u0438\u0444\u0442\u0456\u0432"],"Block spacing":["\u0406\u043d\u0442\u0435\u0440\u0432\u0430\u043b \u043c\u0456\u0436 \u0431\u043b\u043e\u043a\u0430\u043c\u0438"],"An error occurred while resetting the template.":["\u041f\u0456\u0434 \u0447\u0430\u0441 \u0441\u043a\u0438\u0434\u0430\u043d\u043d\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043f\u043e\u043c\u0438\u043b\u043a\u0430."],"\"%s\" reset to default.":["\"%s\" \u0441\u043a\u0438\u043d\u0443\u0442\u043e \u0434\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c."],"Are you sure you want to reset \"%s\" to default?":["\u0412\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456, \u0449\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u0441\u043a\u0438\u043d\u0443\u0442\u0438 \"%s\" \u0434\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c?"],"Select a background color for email clients that do not support background images.":["\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043a\u043e\u043b\u0456\u0440 \u0444\u043e\u043d\u0443 \u0434\u043b\u044f \u043f\u043e\u0448\u0442\u043e\u0432\u0438\u0445 \u043a\u043b\u0456\u0454\u043d\u0442\u0456\u0432, \u044f\u043a\u0456 \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u044e\u0442\u044c \u0444\u043e\u043d\u043e\u0432\u0456 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f."],"Units other than pixels (px) lack support in old email clients.":["\u041e\u0434\u0438\u043d\u0438\u0446\u0456, \u0432\u0456\u0434\u043c\u0456\u043d\u043d\u0456 \u0432\u0456\u0434 \u043f\u0456\u043a\u0441\u0435\u043b\u0456\u0432 (px), \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u044e\u0442\u044c\u0441\u044f \u0441\u0442\u0430\u0440\u0438\u043c\u0438 \u043f\u043e\u0448\u0442\u043e\u0432\u0438\u043c\u0438 \u043a\u043b\u0456\u0454\u043d\u0442\u0430\u043c\u0438."],"Border display may vary or be unsupported in some email clients.":["\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u043c\u0435\u0436 \u043c\u043e\u0436\u0435 \u0432\u0456\u0434\u0440\u0456\u0437\u043d\u044f\u0442\u0438\u0441\u044f \u0430\u0431\u043e \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438\u0441\u044f \u0434\u0435\u044f\u043a\u0438\u043c\u0438 \u043f\u043e\u0448\u0442\u043e\u0432\u0438\u043c\u0438 \u043a\u043b\u0456\u0454\u043d\u0442\u0430\u043c\u0438."],"Sending\u2026":["\u041d\u0430\u0434\u0441\u0438\u043b\u0430\u043d\u043d\u044f\u2026"],"Test email sent successfully!":["\u0422\u0435\u0441\u0442\u043e\u0432\u0438\u0439 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0438\u0439 \u043b\u0438\u0441\u0442 \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u043d\u043e!"],"Send to":["\u0412\u0456\u0434\u043f\u0440\u0430\u0432\u0438\u0442\u0438"],"Send yourself a test email to test how your email would look like in different email apps.":["\u041d\u0430\u0434\u0456\u0448\u043b\u0456\u0442\u044c \u0441\u043e\u0431\u0456 \u0442\u0435\u0441\u0442\u043e\u0432\u0438\u0439 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0438\u0439 \u043b\u0438\u0441\u0442, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438, \u044f\u043a \u0432\u0438\u0433\u043b\u044f\u0434\u0430\u0442\u0438\u043c\u0435 \u0432\u0430\u0448 \u043b\u0438\u0441\u0442 \u0443 \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u043e\u0448\u0442\u043e\u0432\u0438\u0445 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0430\u0445."],"Or, sign up for MailPoet Sending Service to easily send emails. <link>Sign up for free<\/link>":["\u0412\u0438 \u0442\u0430\u043a\u043e\u0436 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u0443\u0432\u0430\u0442\u0438\u0441\u044f \u0432 \u0441\u043b\u0443\u0436\u0431\u0456 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u043d\u043d\u044f MailPoet, \u0449\u043e\u0431 \u043b\u0435\u0433\u043a\u043e \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0456 \u043b\u0438\u0441\u0442\u0438. <link>\u0411\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0430 \u0440\u0435\u0454\u0441\u0442\u0440\u0430\u0446\u0456\u044f<\/link>"],"Please check your <link>sending method configuration<\/link> with your hosting provider.":["\u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 <link>\u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u044e \u043c\u0435\u0442\u043e\u0434\u0443 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u043d\u043d\u044f<\/link> \u0443 \u0441\u0432\u043e\u0433\u043e \u0445\u043e\u0441\u0442\u0438\u043d\u0433-\u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440\u0430."],"Sorry, we were unable to send this email.":["\u041d\u0430 \u0436\u0430\u043b\u044c, \u043c\u0438 \u043d\u0435 \u0437\u043c\u043e\u0433\u043b\u0438 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0446\u0435\u0439 \u043b\u0438\u0441\u0442."],"You have unsaved changes. Please save the post before previewing.":["\u0423 \u0432\u0430\u0441 \u0454 \u043d\u0435\u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0456 \u0437\u043c\u0456\u043d\u0438. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0437\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044c \u0437\u0430\u043f\u0438\u0441 \u043f\u0435\u0440\u0435\u0434 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u043c \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u043e\u043c."],"Personalization Tag":["\u0422\u0435\u0433 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u0457"],"Insert personalization tags to dynamically fill in information and personalize your emails.":["\u0412\u0441\u0442\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u0442\u0435\u0433\u0438 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u0457, \u0449\u043e\u0431 \u0434\u0438\u043d\u0430\u043c\u0456\u0447\u043d\u043e \u0437\u0430\u043f\u043e\u0432\u043d\u044e\u0432\u0430\u0442\u0438 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e \u0442\u0430 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0456 \u043b\u0438\u0441\u0442\u0438."],"Update link":["\u041e\u043d\u043e\u0432\u0438\u0442\u0438 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f"],"Link tag":["\u0422\u0435\u0433 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f"],"Link Text":["\u0422\u0435\u043a\u0441\u0442 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f"],"Insert Link":["\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f"],"Insert as link":["\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u044f\u043a \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f"],"Set as URL":["\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u044f\u043a URL"],"Fix errors to continue:":["\u0412\u0438\u043f\u0440\u0430\u0432\u0442\u0435 \u043f\u043e\u043c\u0438\u043b\u043a\u0438, \u0449\u043e\u0431 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438:"],"Fullscreen mode deactivated.":["\u041f\u043e\u0432\u043d\u043e\u0435\u043a\u0440\u0430\u043d\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e."],"Fullscreen mode activated.":["\u041f\u043e\u0432\u043d\u043e\u0435\u043a\u0440\u0430\u043d\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e."],"Show and hide the admin user interface":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0442\u0430 \u043f\u0440\u0438\u0445\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u0430\u0434\u043c\u0456\u043d\u0456\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0430"],"Fullscreen mode":["\u041f\u043e\u0432\u043d\u043e\u0435\u043a\u0440\u0430\u043d\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c"],"Some errors occurred while performing the action: %s":["\u041f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u0434\u0456\u0457 \u0432\u0438\u043d\u0438\u043a\u043b\u0438 \u0434\u0435\u044f\u043a\u0456 \u043f\u043e\u043c\u0438\u043b\u043a\u0438: %s"],"An error occurred while performing the action: %s":["\u041f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u0434\u0456\u0457 \u0432\u0438\u043d\u0438\u043a\u043b\u0430 \u043f\u043e\u043c\u0438\u043b\u043a\u0430: %s"],"An error occurred while performing the action.":["\u041f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u0434\u0456\u0457 \u0432\u0438\u043d\u0438\u043a\u043b\u0430 \u043f\u043e\u043c\u0438\u043b\u043a\u0430."],"%s item moved to the trash.":["%s \u0437\u0430\u043f\u0438\u0441 \u043f\u0435\u0440\u0435\u043c\u0456\u0449\u0435\u043d\u043e \u0434\u043e \u043a\u043e\u0448\u0438\u043a\u0430.","%s \u0437\u0430\u043f\u0438\u0441\u0430 \u043f\u0435\u0440\u0435\u043c\u0456\u0449\u0435\u043d\u043e \u0434\u043e \u043a\u043e\u0448\u0438\u043a\u0430.","%s \u0437\u0430\u043f\u0438\u0441\u0456\u0432 \u043f\u0435\u0440\u0435\u043c\u0456\u0449\u0435\u043d\u043e \u0434\u043e \u043a\u043e\u0448\u0438\u043a\u0430."],"The items were permanently deleted.":["\u0415\u043b\u0435\u043c\u0435\u043d\u0442\u0438 \u0431\u0443\u043b\u043e \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043e \u043d\u0430\u0437\u0430\u0432\u0436\u0434\u0438."],"\"%s\" moved to the trash.":["\"%s\" \u043f\u0435\u0440\u0435\u043c\u0456\u0449\u0435\u043d\u043e \u0434\u043e \u043a\u043e\