ypography used on headings.":["\u041a\u0435\u0440\u0443\u0439\u0442\u0435 \u0448\u0440\u0438\u0444\u0442\u0430\u043c\u0438 \u0442\u0430 \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0456\u043a\u043e\u044e \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0456\u0432."],"Manage the fonts and typography used on links.":["\u041a\u0435\u0440\u0443\u0439\u0442\u0435 \u0448\u0440\u0438\u0444\u0442\u0430\u043c\u0438 \u0442\u0430 \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0456\u043a\u043e\u044e \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u044c."],"Manage the fonts and typography used on text.":["\u041a\u0435\u0440\u0443\u0439\u0442\u0435 \u0448\u0440\u0438\u0444\u0442\u0430\u043c\u0438 \u0442\u0430 \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0456\u043a\u043e\u044e \u0442\u0435\u043a\u0441\u0442\u0443."],"Line height":["\u0412\u0438\u0441\u043e\u0442\u0430 \u0440\u044f\u0434\u043a\u0430"],"Text decoration":["\u041e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043d\u044f \u0442\u0435\u043a\u0441\u0442\u0443"],"Letter case":["\u0420\u0435\u0433\u0456\u0441\u0442\u0440 \u043b\u0456\u0442\u0435\u0440"],"Manage the typography settings for different elements.":["\u041a\u0435\u0440\u0443\u0439\u0442\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0456\u043a\u0438 \u0434\u043b\u044f \u0440\u0456\u0437\u043d\u0438\u0445 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0456\u0432."],"Navigate to the previous view":["\u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u0434\u043e \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0443"],"Elements":["\u0415\u043b\u0435\u043c\u0435\u043d\u0442\u0438"],"Links":["\u041f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f"],"Headings":["\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438"],"Typography %s styles":["\u0421\u0442\u0438\u043b\u0456 \u0442\u0438\u043f\u043e\u0433\u044