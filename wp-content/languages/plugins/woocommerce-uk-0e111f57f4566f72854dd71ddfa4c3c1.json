Fullscreen mode":["\u041f\u043e\u0432\u043d\u043e\u0435\u043a\u0440\u0430\u043d\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c"],"Sorry, we were unable to send this email.":["\u041d\u0430 \u0436\u0430\u043b\u044c, \u043c\u0438 \u043d\u0435 \u0437\u043c\u043e\u0433\u043b\u0438 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0446\u0435\u0439 \u043b\u0438\u0441\u0442."],"Swap template":["\u0417\u0430\u043c\u0456\u043d\u0438\u0442\u0438 \u0448\u0430\u0431\u043b\u043e\u043d"],"Template actions":["\u0414\u0456\u0457 \u0437 \u0448\u0430\u0431\u043b\u043e\u043d\u043e\u043c"],"Start from scratch":["\u041f\u043e\u0447\u0430\u0442\u0438 \u0437 \u043d\u0443\u043b\u044f"],"rendering template":["\u0448\u0430\u0431\u043b\u043e\u043d \u0440\u0435\u043d\u0434\u0435\u0440\u0438\u043d\u0433\u0443"],"Templates created on the legacy editor will not appear here.":["\u0428\u0430\u0431\u043b\u043e\u043d\u0438, \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u0456 \u0443 \u0441\u0442\u0430\u0440\u043e\u043c\u0443 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0456, \u0442\u0443\u0442 \u043d\u0435 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u0438\u043c\u0443\u0442\u044c\u0441\u044f."],"Your recent creations will appear here as soon as you begin.":["\u0412\u0430\u0448\u0456 \u043e\u0441\u0442\u0430\u043d\u043d\u0456 \u0440\u043e\u0431\u043e\u0442\u0438 \u0437'\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u0442\u0443\u0442, \u044f\u043a \u0442\u0456\u043b\u044c\u043a\u0438 \u0432\u0438 \u043f\u043e\u0447\u043d\u0435\u0442\u0435."],"No recent templates.":["\u041d\u0435\u043c\u0430\u0454 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0445 \u0448\u0430\u0431\u043b\u043e\u043d\u0456\u0432."],"Border display may vary or be unsupported in some email clients.":["\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u043c\u0435\u0436 \u043c\u043e\u0436\u0435 \u0432\u0456\u0434\u0440\u0456\u0437\u043d\u044f\u0442\u0438\u0441\u044f \u0430\u0431\u043e \u043d