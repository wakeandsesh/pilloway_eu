u0430\u043b\u0438 \u0432\u0441\u0456 \u0441\u0432\u043e\u0457 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f"],"To-dos, tips, and insights for your business":["\u0417\u0430\u0432\u0434\u0430\u043d\u043d\u044f, \u043f\u043e\u0440\u0430\u0434\u0438 \u0442\u0430 \u0456\u0434\u0435\u0457 \u0434\u043b\u044f \u0432\u0430\u0448\u043e\u0433\u043e \u0431\u0456\u0437\u043d\u0435\u0441\u0443"],"Marketing & Merchandising":["\u041c\u0430\u0440\u043a\u0435\u0442\u0438\u043d\u0433 \u0456 \u043f\u0440\u043e\u0441\u0443\u0432\u0430\u043d\u043d\u044f"],"Keep an eye on your views and visitors metrics with Jetpack. Requires Jetpack plugin and a WordPress.com account.":["\u0412\u0456\u0434\u0441\u0442\u0435\u0436\u0443\u0439\u0442\u0435 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0456\u0432 \u0456 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0456\u0432 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Jetpack. \u041f\u043e\u0442\u0440\u0456\u0431\u0435\u043d \u043f\u043b\u0430\u0433\u0456\u043d Jetpack \u0442\u0430 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 WordPress.com."],"WooCommerce Docs":["\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0456\u044f \u043f\u043e WooCommerce"],"Which Payment Option is Right for Me?":["\u042f\u043a\u0438\u0439 \u0432\u0430\u0440\u0456\u0430\u043d\u0442 \u043e\u043f\u043b\u0430\u0442\u0438 \u043f\u0456\u0434\u0445\u043e\u0434\u0438\u0442\u044c \u043c\u0435\u043d\u0456?"],"Automated Tax calculation using WooCommerce Tax":["\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0435 \u043e\u0431\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044f \u0441\u0443\u043c\u0438 \u043f\u043e\u0434\u0430\u0442\u043a\u0443 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e WooCommerce Tax"],"Setting up Taxes in WooCommerce":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0443 WooCommerce"],"Learn more about configuring your shipping settings":["\u0414\u0456\u0437\u043d\u0430\u0439\u0442\u0435\u0441\u044f \u0431\u0456\u043b\u044c\u0448\u0435 \u043f\u0440\u043e \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0456\u0432 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"],"WooCommerce Shipping setup and configuration":["\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0442\u0430 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f WooCommerce Shipping"],"Product Shipping Classes":["\u041a\u043b\u0430\u0441\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0442\u043e\u0432\u0430\u0440\u0456\u0432"],"Core Shipping Options":["\u041e\u0441\u043d\u043e\u0432\u043d\u0456 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"],"Setting up Shipping Zones":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u043e\u043d \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"],"How to choose and change a theme":["\u0412\u0438\u0431\u0456\u0440 \u0456 \u0437\u043c\u0456\u043d\u0430 \u0442\u0435\u043c\u0438"],"Manage Store Notice, Catalog View and Product Images":["\u041a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f\u043c\u0438 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0443, \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0443 \u0456 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0442\u043e\u0432\u0430\u0440\u0443"],"Showcase your products and tailor your shopping experience using Blocks":["\u0414\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0443\u0439\u0442\u0435 \u0441\u0432\u043e\u0457 \u0442\u043e\u0432\u0430\u0440\u0438 \u0442\u0430 \u043d\u0430\u043f\u043e\u0432\u043d\u044e\u0439\u0442\u0435 \u043c\u0430\u0433\u0430\u0437\u0438\u043d \u0432\u043c\u0456\u0441\u0442\u043e\u043c \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0431\u043b\u043e\u043a\u0456\u0432"],"Learn more about setting up products":["\u0414\u0456\u0437\u043d\u0430\u0439\u0442\u0435\u0441\u044f \u0431\u0456\u043b\u044c\u0448\u0435 \u043f\u0440\u043e \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u043e\u0432\u0430\u0440\u0456\u0432"],"Import products using the CSV Importer and Exporter":["\u0406\u043c\u043f\u043e\u0440\u0442\u0443\u0439\u0442\u0435 \u0442\u043e\u0432\u0430\u0440\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0437\u0430\u0441\u043e\u0431\u0443 \u0456\u043c\u043f\u043e\u0440\u0442\u0443 \u0442\u0430 \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0443 \u0444\u0430\u0439\u043b\u0456\u0432 CSV"],"Adding and Managing Products":["\u0414\u043e\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u043e\u0432\u0430\u0440\u0430\u043c\u0438"],"Migrate products using Cart2Cart":["\u041f\u0435\u0440\u0435\u043d\u043e\u0441\u044c\u0442\u0435 \u0442\u043e\u0432\u0430\u0440\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Cart2Cart"],"Cash on Delivery":["\u041e\u043f\u043b\u0430\u0442\u0430 \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u0446\u0456"],"Square - Get started":["Square - \u041f\u0440\u0438\u0441\u0442\u0443\u043f\u0438\u0442\u0438"],"PayPal Checkout Setup and Configuration":["\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f PayPal Checkout"],"Stripe Setup and Configuration":["\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f Stripe"],"Eway Setup and Configuration":["\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f Eway"],"Direct Bank Transfer (BACS)":["\u0411\u0430\u043d\u043a\u0456\u0432\u0441\u044c\u043a\u0438\u0439 \u043f\u0435\u0440\u0435\u043a\u0430\u0437 (BACS)"],"Klarna - Introduction":["Klarna - \u0432\u0441\u0442\u0443\u043f"],"Payfast Setup and Configuration":["\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0442\u0430 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f Payfast"],"View detailed stats":["\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0443 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443"],"Month to date":["\u0417\u0430 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0439 \u043c\u0456\u0441\u044f\u0446\u044c"],"Week to date":["\u0417\u0430 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0439 \u0442\u0438\u0436\u0434\u0435\u043d\u044c"],"Get traffic stats with Jetpack":["\u041e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438 \u0442\u0440\u0430\u0444\u0456\u043a\u0443 \u0456\u0437 Jetpack"],"Connect Jetpack":["\u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0438 Jetpack"],"Activate Jetpack":["\u0410\u043a\u0442\u0438\u0432\u0443\u0432\u0430\u0442\u0438 Jetpack"],"Get Jetpack":["\u041e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 Jetpack"],"Store management":["\u041a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u043e\u043c"],"View my store":["\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u043c\u0456\u0439 \u043c\u0430\u0433\u0430\u0437\u0438\u043d"],"Store details":["\u0412\u0456\u0434\u043e\u043c\u043e\u0441\u0442\u0456 \u043f\u0440\u043e \u043c\u0430\u0433\u0430\u0437\u0438\u043d"],"Dismiss all messages":["\u0412\u0456\u0434\u0445\u0438\u043b\u0438\u0442\u0438 \u0432\u0441\u0456 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f"],"Undo":["\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438"],"Message dismissed":["\u041f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u0432\u0456\u0434\u0445\u0438\u043b\u0435\u043d\u043e"],"All messages dismissed":["\u0412\u0441\u0456 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u0432\u0456\u0434\u0445\u0438\u043b\u0435\u043d\u043e"],"Messages could not be dismissed":["\u041f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0432\u0456\u0434\u0445\u0438\u043b\u0438\u0442\u0438"],"Message could not be dismissed":["\u041d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0432\u0456\u0434\u0445\u0438\u043b\u0438\u0442\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f","\u041d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0432\u0456\u0434\u0445\u0438\u043b\u0438\u0442\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f","\u041d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0432\u0456\u0434\u0445\u0438\u043b\u0438\u0442\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f"],"Home Screen":["\u0413\u043e\u043b\u043e\u0432\u043d\u0438\u0439 \u0435\u043a\u0440\u0430\u043d"],"Stats overview":["\u041e\u0433\u043b\u044f\u0434 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438"],"Unregistered Statuses":["\u041d\u0435\u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u043e\u0432\u0430\u043d\u0456 \u0441\u0442\u0430\u0442\u0443\u0441\u0438"],"Update stock":["\u041e\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u0430\u043f\u0430\u0441\u0438"],"%d in stock":["%d \u0432 \u043d\u0430\u044f\u0432\u043d\u043e\u0441\u0442\u0456"],"You currently don\u2019t have any actionable statuses. To display orders here, select orders that require further review in settings.":["\u0412 \u0434\u0430\u043d\u0438\u0439 \u0447\u0430\u0441 \u0443 \u0432\u0430\u0441 \u043d\u0435\u043c\u0430\u0454 \u0441\u0442\u0430\u0442\u0443\u0441\u0456\u0432, \u044f\u043a\u0456 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u044e\u0442\u044c \u0434\u0456\u0439. \u0429\u043e\u0431 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0437\u0438\u0442\u0438 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0442\u0443\u0442, \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f, \u044f\u043a\u0456 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u044e\u0442\u044c \u043f\u043e\u0434\u0430\u043b\u044c\u0448\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0443 \u0432 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445."],"Inbox":["\u0412\u0445\u0456\u0434\u043d\u0456"],"Manage all orders":["\u041a\u0435\u0440\u0443\u0432\u0430\u0442\u0438 \u0432\u0441\u0456\u043c\u0430 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f\u043c\u0438"],"There was an error getting your inbox. Please try again.":["\u041f\u0456\u0434 \u0447\u0430\u0441 \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u0432\u0445\u0456\u0434\u043d\u0438\u0445 \u043b\u0438\u0441\u0442\u0456\u0432 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043f\u043e\u043c\u0438\u043b\u043a\u0430. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."],"%s stock could not be updated":["\u0417\u0430\u043f\u0430\u0441 %s \u043d\u0435 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0439"],"%s stock updated":["\u0417\u0430\u043f\u0430\u0441 %s \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043e"],"As things begin to happen in your store your inbox will start to fill up. You\u2019ll see things like achievements, new feature announcements, extension recommendations and more!":["\u042f\u043a \u0442\u0456\u043b\u044c\u043a\u0438 \u0443 \u0432\u0430\u0448\u043e\u043c\u0443 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0456 \u043f\u043e\u0447\u043d\u0443\u0442\u044c \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0442\u0438\u0441\u044f \u043f\u043e\u0434\u0456\u0457, \u0432\u0430\u0448\u0430 \u043f\u043e\u0448\u0442\u043e\u0432\u0430 \u0441\u043a\u0440\u0438\u043d\u044c\u043a\u0430 \u043f\u043e\u0447\u043d\u0435 \u0437\u0430\u043f\u043e\u0432\u043d\u044e\u0432\u0430\u0442\u0438\u0441\u044f. \u0412\u0438 \u0431\u0443\u0434\u0435\u0442\u0435 \u043e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u0442\u0430\u043a\u0443 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e, \u044f\u043a \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f, \u0430\u043d\u043e\u043d\u0441\u0438 \u043d\u043e\u0432\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0456\u0439, \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0457 \u0449\u043e\u0434\u043e \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u044c \u0442\u0430 \u0431\u0430\u0433\u0430\u0442\u043e \u0456\u043d\u0448\u043e\u0433\u043e!"],"Your inbox is empty":["\u0412\u0430\u0448\u0430 \u043f\u043e\u0448\u0442\u043e\u0432\u0430 \u0441\u043a\u0440\u0438\u043d\u044c\u043a\u0430 \u043f\u043e\u0440\u043e\u0436\u043d\u044f"],"Personalize my store":["\u041f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u043c\u0456\u0439 \u043c\u0430\u0433\u0430\u0437\u0438\u043d"],"Display stats":["\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0437\u0438\u0442\u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443"],"Select a default date range. When no range is selected, reports will be viewed by the default date range.":["\u041e\u0431\u0435\u0440\u0456\u0442\u044c \u0434\u0456\u0430\u043f\u0430\u0437\u043e\u043d \u0434\u0430\u0442. \u042f\u043a\u0449\u043e \u0439\u043e\u0433\u043e \u043d\u0435 \u043e\u0431\u0440\u0430\u043d\u043e, \u0437\u0432\u0456\u0442\u043