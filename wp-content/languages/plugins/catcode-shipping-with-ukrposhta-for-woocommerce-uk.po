#: includes/Checkout/Picker.php:109
msgid "Choose a city first"
msgstr "Спочатку оберіть місто"

#: includes/Checkout/Picker.php:110
msgid "Pick a post office or an index…"
msgstr "Оберіть відділення або індекс…"

#: includes/Checkout/Picker.php:111
msgid "Searching…"
msgstr "Пошук…"

#: includes/Checkout/Picker.php:112
