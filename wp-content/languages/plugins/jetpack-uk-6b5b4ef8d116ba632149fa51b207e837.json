0\u043a\u0442\u043e\u0440."],"Something went wrong applying your edits.":["\u0429\u043e\u0441\u044c \u043f\u0456\u0448\u043b\u043e \u043d\u0435 \u0442\u0430\u043a \u043f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0430\u0448\u0438\u0445 \u0437\u043c\u0456\u043d."],"The private video could not be loaded.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u0435 \u0432\u0456\u0434\u0435\u043e."],"The original video is unavailable.":["\u041e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u044c\u043d\u0435 \u0432\u0456\u0434\u0435\u043e \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0435."],"This video is processing. You can leave this page and come back later.":["\u0426\u0435 \u0432\u0456\u0434\u0435\u043e \u043e\u0431\u0440\u043e\u0431\u043b\u044f\u0454\u0442\u044c\u0441\u044f. \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u0446\u044e \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443 \u0442\u0430 \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f \u043f\u0456\u0437\u043d\u0456\u0448\u0435."],"Restore original\u2026":["\u0412\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u2026"],"Trim & cut":["\u041e\u0431\u0440\u0456\u0437\u0430\u043d\u043d\u044f \u0442\u0430 \u0432\u0438\u0440\u0456\u0437\u0430\u043d\u043d\u044f"],"Host, manage, customize, and track your videos \u2014 all in one place. <link>Learn more<\/link>.":["\u0420\u043e\u0437\u043c\u0456\u0449\u0443\u0439\u0442\u0435, \u043a\u0435\u0440\u0443\u0439\u0442\u0435, \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0442\u0430 \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0443\u0439\u0442\u0435 \u0441\u0432\u043e\u0457 \u0432\u0456\u0434\u0435\u043e - \u0443\u0441\u0435 \u0432 \u043e\u0434\