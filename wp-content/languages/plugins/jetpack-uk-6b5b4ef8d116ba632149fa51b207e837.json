\u0430 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f Jetpack: %s"],"User connection":["\u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430"],"Another user's account":["\u041e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u0456\u043d\u0448\u043e\u0433\u043e \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430"],"Your account":["\u0412\u0430\u0448 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441"],"Connection owner's account":["\u041e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u0432\u043b\u0430\u0441\u043d\u0438\u043a\u0430 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f"],"Connection owner's account (%s)":["\u041e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u0432\u043b\u0430\u0441\u043d\u0438\u043a\u0430 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f (%s)"],"Your account (connection owner)":["\u0412\u0430\u0448 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 (\u0432\u043b\u0430\u0441\u043d\u0438\u043a \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f)"],"Keyboard shortcut: %s":["\u041a\u043e\u043c\u0431\u0456\u043d\u0430\u0446\u0456\u044f \u043a\u043b\u0430\u0432\u0456\u0448: %s"],"Sections":["\u0420\u043e\u0437\u0434\u0456\u043b\u0438"],"More actions":["\u0411\u0456\u043b\u044c\u0448\u0435 \u0434\u0456\u0439"],"This video is still processing. The editor will be available once it finishes.":["\u0426\u0435 \u0432\u0456\u0434\u0435\u043e \u0449\u0435 \u043e\u0431\u0440\u043e\u0431\u043b\u044f\u0454\u0442\u044c\u0441\u044f. \u0420\u0435\u0434\u0430\u043a\u0442\u043e\u0440 \u0441\u0442\u0430\u043d\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u043c \u043f\u0456\u0441\u043b\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044f \u043e\u0431\u0440\u043e\u0431\u043a\u0438."],"You have unsaved chapter changes. Leave this page and discard them?":["\u0423 \u0432\u0430\u0441 \u0454 \u043d\u0435\u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0456 \u0437\u043c\u0456\u043d\u0438 \u0440\u043e\u0437\u0434\u0456\u043b\u0456\u0432. \u0417\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u0446\u044e \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443 \u0442\u0430 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438 \u0457\u0445?"],"Back to Library":["\u041f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044c \u0434\u043e \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a\u0438"],"We couldn't find that video.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u043d\u0430\u0439\u0442\u0438 \u0446\u0435 \u0432\u0456\u0434\u0435\u043e."],"Your unsaved chapter changes will be discarded and the chapters will return to the last saved version.":["\u0412\u0430\u0448\u0456 \u043d\u0435\u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0456 \u0437\u043c\u0456\u043d\u0438 \u0440\u043e\u0437\u0434\u0456\u043b\u0456\u0432 \u0431\u0443\u0434\u0435 \u0441\u043a\u0430\u0441\u043e\u0432\u0430\u043d\u043e, \u0430 \u0440\u043e\u0437\u0434\u0456\u043b\u0438 \u0431\u0443\u0434\u0435 \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u043e \u0434\u043e \u043e\u0441\u0442\u0430\u043d\u043d\u044c\u043e\u0457 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e\u0457 \u0432\u0435\u0440\u0441\u0456\u0457."],"Discard changes?":["\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438 \u0437\u043c\u0456\u043d\u0438?"],"Editing tools":["\u0406\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438 \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043d\u043d\u044f"],"Editor":["\u0420\u0435\u0434\u0430\u043a\u0442\u043e\u0440"],"VideoPress needs a connection to WordPress.com before you can upload and manage your videos.":["VideoPress \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0454 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u0434\u043e WordPress.com, \u043f\u0435\u0440\u0448 \u043d\u0456\u0436 \u0432\u0438 \u0437\u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0432\u0430\u0442\u0438 \u0432\u0456\u0434\u0435\u043e \u0442\u0430 \u043a\u0435\u0440\u0443\u0432\u0430\u0442\u0438 \u043d\u0438\u043c\u0438."],"Connect to set up VideoPress":["\u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0456\u0442\u044c\u0441\u044f, \u0449\u043e\u0431 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 VideoPress"],"Video chapters could not be updated.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043e\u043d\u043e\u0432\u0438\u0442\u0438 \u0440\u043e\u0437\u0434\u0456\u043b\u0438 \u0432\u0456\u0434\u0435\u043e."],"Chapters cannot start after the video ends.":["\u0420\u043e\u0437\u0434\u0456\u043b\u0438 \u043d\u0435 \u043c\u043e\u0436\u0443\u0442\u044c \u043f\u043e\u0447\u0438\u043d\u0430\u0442\u0438\u0441\u044f \u043f\u0456\u0441\u043b\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044f \u0432\u0456\u0434\u0435\u043e."],"Chapters must be at least 10 seconds apart.":["\u041c\u0456\u0436 \u0440\u043e\u0437\u0434\u0456\u043b\u0430\u043c\u0438 \u043c\u0430\u0454 \u0431\u0443\u0442\u0438 \u0449\u043e\u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0435 10 \u0441\u0435\u043a\u0443\u043d\u0434."],"Chapters must be in ascending order without repeated timestamps.":["\u0420\u043e\u0437\u0434\u0456\u043b\u0438 \u043c\u0430\u044e\u0442\u044c \u0431\u0443\u0442\u0438 \u0432 \u043f\u043e\u0440\u044f\u0434\u043a\u0443 \u0437\u0440\u043e\u0441\u0442\u0430\u043d\u043d\u044f \u0431\u0435\u0437 \u043f\u043e\u0432\u0442\u043e\u0440\u044e\u0432\u0430\u043d\u0438\u0445 \u0447\u0430\u0441\u043e\u0432\u0438\u0445 \u043f\u043e\u0437\u043d\u0430\u0447\u043e\u043a."],"Every chapter needs a title.":["\u041a\u043e\u0436\u0435\u043d \u0440\u043e\u0437\u0434\u0456\u043b \u043c\u0430\u0454 \u043c