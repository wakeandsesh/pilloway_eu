0437 \u043f\u043e\u043c\u0438\u043b\u043a\u0443 PHP. \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0436\u0443\u0440\u043d\u0430\u043b \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0430\u0431\u043e \u0437\u0432\u0435\u0440\u043d\u0456\u0442\u044c\u0441\u044f \u0434\u043e \u0441\u0432\u043e\u0433\u043e \u0445\u043e\u0441\u0442\u0438\u043d\u0433-\u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440\u0430."],"Loading %s settings\u2026":["\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f %s \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c\u2026"],"Return to payments settings":["\u041f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f \u0434\u043e \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c \u043f\u043b\u0430\u0442\u0435\u0436\u0456\u0432"],"Manage email notifications sent from WooCommerce below or click on 'Edit template' to customize your email template design.":["\u041a\u0435\u0440\u0443\u0439\u0442\u0435 \u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f\u043c\u0438 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u044e \u043f\u043e\u0448\u0442\u043e\u044e, \u0449\u043e \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u044e\u0442\u044c\u0441\u044f \u0437 WooCommerce, \u043d\u0438\u0436\u0447\u0435 \u0430\u0431\u043e \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u00ab\u0420\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u0448\u0430\u0431\u043b\u043e\u043d\u00bb, \u0449\u043e\u0431 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 \u0434\u0438\u0437\u0430\u0439\u043d \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0457 \u043f\u043e\u0448\u0442\u0438."],"An unknown error occurred while exporting the settings.":["\u041f\u0456\u0434 \u0447\u0430\u0441 \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0443 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043d\u0435\u0432\u0456\u0434\u043e\u043c\u0430 \u043f\u043e\u043c\u0438\u043b\u043a\u0430."],"Sorry, you are not allowed to export the selected settings.":["\u041d\u0430 \u0436\u0430\u043b\u044c, \u0432\u0430\u043c \u043d\u0435 \u0434\u043e\u0437\u0432\u043e\u043b\u0435\u043d\u043e \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u0432\u0438\u0431\u0440\u0430\u043d\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f."],"more":["\u0431\u0456\u043b\u044c\u0448\u0435"],"Blueprints are setup files containing WooCommerce settings, plugins, and themes. Simplify setup, streamline team collaboration, and <docLink \/>.":["\u041a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u0457 (Blueprints) \u2013 \u0446\u0435 \u0444\u0430\u0439\u043b\u0438 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c, \u0449\u043e \u043c\u0456\u0441\u0442\u044f\u0442\u044c \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0442\u0435\u043c\u0438 WooCommerce. \u0421\u043f\u0440\u043e\u0441\u0442\u0456\u0442\u044c \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f, \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0439\u0442\u0435 \u0441\u043f\u0456\u0432\u043f\u0440\u0430\u0446\u044e \u0432 \u043a\u043e\u043c\u0430\u043d\u0434\u0456 \u0442\u0430 <docLink \/>."],"Maximum size: 50 MB":["\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0438\u0439 \u0440\u043e\u0437\u043c\u0456\u0440: 50 \u041c\u0411"],"Import a .json file. You can import only one Blueprint at a time.":["\u0406\u043c\u043f\u043e\u0440\u0442\u0443\u0439\u0442\u0435 \u0444\u0430\u0439\u043b .json. \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0456\u043c\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u043b\u0438\u0448\u0435 \u043e\u0434\u043d\u0443 \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u044e \u0437\u0430 \u0440\u0430\u0437."],"Blueprint imports are disabled by default for live sites. <br\/>Enable <link>Coming Soon mode<\/link> or define \"ALLOW_BLUEPRINT_IMPORT_IN_LIVE_MODE\" as true.":["\u0406\u043c\u043f\u043e\u0440\u0442 \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u0439 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0434\u043b\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0445 \u0441\u0430\u0439\u0442\u0456\u0432. <br\/>\u0423\u0432\u0456\u043c\u043a\u043d\u0456\u0442\u044c <link>\u0440\u0435\u0436\u0438\u043c \u00ab\u0421\u043a\u043e\u0440\u043e \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0442\u044f\u00bb<\/link> \u0430\u0431\u043e \u0432\u0438\u0437\u043d\u0430\u0447\u0442\u0435 \u0434\u043b\u044f \u00abALLOW_BLUEPRINT_IMPORT_IN_LIVE_MODE\u00bb \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f true."],"Step: %1$s Errors: %2$s":["\u041a\u0440\u043e\u043a: %1$s \u041f\u043e\u043c\u0438\u043b\u043a\u0438: %2$s"],"Failed to check if imports are allowed.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438, \u0447\u0438 \u0434\u043e\u0437\u0432\u043e\u043b\u0435\u043d\u043e \u0456\u043c\u043f\u043e\u0440\u0442."],"An error occurred while importing your Blueprint.":["\u041f\u0456\u0434 \u0447\u0430\u0441 \u0456\u043c\u043f\u043e\u0440\u0442\u0443 \u0432\u0430\u0448\u043e\u0457 \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u0457 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043f\u043e\u043c\u0438\u043b\u043a\u0430."],"Error reading or parsing file. Please check the schema.":["\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0447\u0438\u0442\u0430\u043d\u043d\u044f \u0430\u0431\u043e \u0440\u043e\u0437\u0431\u043e\u0440\u0443 \u0444\u0430\u0439\u043b\u0443. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0441\u0445\u0435\u043c\u0443."],"Step exceeds maximum size limit of %1$.2fMB (Current: %2$.2fMB)":["\u041a\u0440\u043e\u043a \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0443\u0454 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0438\u0439 \u0440\u043e\u0437\u043c\u0456\u0440 %1$.2f \u041c\u0411 (\u043f\u043e\u0442\u043e\u0447\u043d\u0438\u0439: %2$.2f \u041c\u0411)"],"Invalid JSON format: Expected an array.":["\u041d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0438\u0439 \u0444\u043e\u0440\u043c\u0430\u0442 JSON: \u043e\u0447\u0456\u043a\u0443\u0432\u0430\u0432\u0441\u044f \u043c\u0430\u0441\u0438\u0432."],"Check payments":["\u041e\u043f\u043b\u0430\u0442\u0430 \u0427\u0435\u043a\u043e\u043c"],"I was able to customize my email designs to match my store\u2019s brand.":["\u042f \u0437\u043c\u0456\u0433 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 \u0434\u0438\u0437\u0430\u0439\u043d \u0441\u0432\u043e\u0457\u0445 \u043b\u0438\u0441\u0442\u0456\u0432 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u043e \u0434\u043e \u0431\u0440\u0435\u043d\u0434\u0443 \u043c\u043e\u0433\u043e \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0443."],"Thank you for trying out our new email customization features. We\u2019d love to hear your feedback on how we could improve the experience.":["\u0414\u044f\u043a\u0443\u0454\u043c\u043e \u0432\u0430\u043c \u0437\u0430 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u043d\u0430\u0448\u0438\u0445 \u043d\u043e\u0432\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0456\u0439 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043b\u0438\u0441\u0442\u0456\u0432. \u041d\u0430\u043c \u0432\u0430\u0436\u043b\u0438\u0432\u043e \u043f\u043e\u0447\u0443\u0442\u0438 \u0432\u0430\u0448\u0456 \u0432\u0456\u0434\u0433\u0443\u043a\u0438 \u043f\u0440\u043e \u0442\u0435, \u044f\u043a \u043c\u0438 \u043c\u043e\u0433\u043b\u0438 \u0431 \u043f\u043e\u043b\u0456\u043f\u0448\u0438\u0442\u0438 \u0446\u0435\u0439 \u043c\u0435\u0445\u0430\u043d\u0456\u0437\u043c."],"I am able to customize my email designs to match my store\u2019s brand.":["\u042f \u0437\u043c\u0456\u0433 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 \u0434\u0438\u0437\u0430\u0439\u043d \u0441\u0432\u043e\u0457\u0445 \u043b\u0438\u0441\u0442\u0456\u0432 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u043e \u0434\u043e \u0431\u0440\u0435\u043d\u0434\u0443 \u0441\u0432\u043e\u0433\u043e \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0443."],"Auto-sync with theme changes":["\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0430 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u044f \u0437\u0456 \u0437\u043c\u0456\u043d\u043e\u044e \u0442\u0435\u043c\u0438"],"Blueprint setting icon - %s":["\u0406\u043a\u043e\u043d\u043a\u0430 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u0457 - %s"],"What did you try to achieve with the customizer? What did and didn't work?":["\u0427\u043e\u0433\u043e \u0432\u0438 \u043d\u0430\u043c\u0430\u0433\u0430\u043b\u0438\u0441\u044f \u0434\u043e\u0441\u044f\u0433\u0442\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f? \u0429\u043e \u0441\u043f\u0440\u0430\u0446\u044e\u0432\u0430\u043b\u043e, \u0430 \u0449\u043e \u043d\u0456?"],"How can we improve the email customizer for you? (Optional)":["\u042f\u043a \u043c\u0438 \u043c\u043e\u0436\u0435\u043c\u043e \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 \u043c\u0435\u0445\u0430\u043d\u0456\u0437\u043c \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043b\u0438\u0441\u0442\u0456\u0432 \u0434\u043b\u044f \u0432\u0430\u0441? (\u041d\u0435\u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u043e)"],"Importing your file\u2026":["\u0406\u043c\u043f\u043e\u0440\u0442 \u0444\u0430\u0439\u043b\u0443..."],"choose a file":["\u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0444\u0430\u0439\u043b"],"Your Blueprint has been imported, but there were some errors. Please check the messages.":["\u0412\u0430\u0448\u0443 \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u044e \u0456\u043c\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u043e, \u0430\u043b\u0435 \u0432\u0438\u043d\u0438\u043a\u043b\u0438 \u0434\u0435\u044f\u043a\u0456 \u043f\u043e\u043c\u0438\u043b\u043a\u0438. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f."],"Drag and drop or":["\u041f\u0435\u0440\u0435\u0442\u044f\u0433\u043d\u0456\u0442\u044c \u0430\u0431\u043e"],"Importing the file will overwrite the current configuration in WooCommerce Settings.":["\u0406\u043c\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0444\u0430\u0439\u043b\u0443 \u0437\u0430\u043c\u0456\u043d\u0438\u0442\u044c \u043f\u043e\u0442\u043e\u0447\u043d\u0443 \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u044e \u0432 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445 WooCommerce."],"Test email sent successfully!":["\u0422\u0435\u0441\u0442\u043e\u0432\u0438\u0439 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0438\u0439 \u043b\u0438\u0441\u0442 \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u043d\u043e!"],"Share if you would like to discuss your experience or participate in future research.":["\u041f\u043e\u0434\u0456\u043b\u0456\u0442\u044c\u0441\u044f \u0432\u0440\u0430\u0436\u0435\u043d\u043d\u044f\u043c\u0438, \u044f\u043a\u0449\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u0431\u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0438 \u0441\u0432\u0456\u0439 \u0434\u043e\u0441\u0432\u0456\u0434 \u0447\u0438 \u0432\u0437\u044f\u0442\u0438 \u0443\u0447\u0430\u0441\u0442\u044c \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u0456\u0445 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f\u0445."],"Share your experience":["\u041f\u043e\u0434\u0456\u043b\u0456\u0442\u044c\u0441\u044f \u0441\u0432\u043e\u0457\u043c \u0434\u043e\u0441\u0432\u0456\u0434\u043e\u043c"],"Email address (Optional)":["E-mail \u0430\u0434\u0440\u0435\u0441\u0430 (\u043d\u0435\u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u043e)"],"Your Blueprint has been imported!":["\u0412\u0430\u0448\u0443 \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u044e \u0456\u043c\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u043e!"],"Importing the file will overwrite the current configuration for the following items in WooCommerce Settings:":["\u0406\u043c\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0444\u0430\u0439\u043b\u0443 \u0437\u0430\u043c\u0456\u043d\u0438\u0442\u044c \u043f\u043e\u0442\u043e\u0447\u043d\u0443 \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u044e \u0434\u043b\u044f \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0445 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0456\u0432 \u0443 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445 WooCommerce:"],"Change image":["\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f"],"Image preview":["\u041f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u0439 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f"],"WooCommerce Settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f WooCommerce"],"Send a test email":["\u0412\u0456\u0434\u043f\u0440\u0430\u0432\u0438\u0442\u0438 \u0442\u0435\u0441\u0442\u043e\u0432\u0438\u0439 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043