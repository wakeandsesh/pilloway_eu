u0440\u0443 %d \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0432\u043a\u0430\u0437\u0430\u0442\u0438 \u0447\u0430\u0441 \u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0442\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044f."],"Subtitle %d needs text before publishing.":["\u041f\u0435\u0440\u0435\u0434 \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0446\u0456\u0454\u044e, \u0434\u043b\u044f \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0443 %d, \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0434\u043e\u0434\u0430\u0442\u0438 \u0442\u0435\u043a\u0441\u0442."],"Ready":["\u0413\u043e\u0442\u043e\u0432\u043e"],"Failed: %s":["\u041f\u043e\u043c\u0438\u043b\u043a\u0430: %s"],"Auto-generated":["\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0437\u0433\u0435\u043d\u0435\u0440\u043e\u0432\u0430\u043d\u043e"],"Add subtitle":["\u0414\u043e\u0434\u0430\u0442\u0438 \u0441\u0443\u0431\u0442\u0438\u0442\u0440"],"Create cues":["\u0421\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0442\u0438\u0442\u0440\u0438"],"button: replace the existing subtitle cues with the pasted text\u0004Replace":["\u0417\u0430\u043c\u0456\u043d\u0438\u0442\u0438"],"Append":["\u0414\u043e\u0434\u0430\u0442\u0438 \u0432 \u043a\u0456\u043d\u0435\u0446\u044c"],"Paste timed captions to keep their timings, or plain text to create evenly spaced cues.":["\u0412\u0441\u0442\u0430\u0432\u0442\u0435 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0438 \u0437 \u0447\u0430\u0441\u043e\u0432\u0438\u043c\u0438 \u043c\u0456\u0442\u043a\u0430\u043c\u0438, \u0449\u043e\u0431 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0457\u0445\u043d\u0456\u0439 \u0447\u0430\u0441, \u0430\u0431\u043e \u0437\u0432\u0438\u0447\u0430\u0439\u043d\u0438\u0439 \u0442\u0435\u043a\u0441\u0442 \u0434\u043b\u044f \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u0440\u0456\u0432\u043d\u043e\u043c\u0456\u0440\u043d\u043e \u0440\u043e\u0437\u043f\u043e\u0434\u0456\u043b\u0435\u043d\u0438\u0445 \u0442\u0438\u0442\u0440\u0456\u0432."],"Subtitle text":["\u0422\u0435\u043a\u0441\u0442 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0456\u0432"],"Keyboard shortcuts: Space plays or pauses the preview, the Left and Right arrow keys seek, C adds a subtitle at the playhead, N and P jump to the next or previous subtitle, and Control+Z or Command+Z undoes an edit (add Shift to redo).":["\u041a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u043d\u0456 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f: \u043f\u0440\u043e\u0431\u0456\u043b \u0432\u0456\u0434\u0442\u0432\u043e\u0440\u044e\u0454 \u0430\u0431\u043e \u043f\u0440\u0438\u0437\u0443\u043f\u0438\u043d\u044f\u0454 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u0439 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434, \u043a\u043b\u0430\u0432\u0456\u0448\u0456 \u0437\u0456 \u0441\u0442\u0440\u0456\u043b\u043a\u0430\u043c\u0438 \u0432\u043b\u0456\u0432\u043e \u0442\u0430 \u0432\u043f\u0440\u0430\u0432\u043e \u043f\u0435\u0440\u0435\u043c\u043e\u0442\u0443\u044e\u0442\u044c, C \u0434\u043e\u0434\u0430\u0454 \u0441\u0443\u0431\u0442\u0438\u0442\u0440 \u0443 \u043f\u043e\u0437\u0438\u0446\u0456\u0457 \u0432\u0456\u0434\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f, N \u0456 P \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u044f\u0442\u044c \u0434\u043e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u043e\u0433\u043e \u0430\u0431\u043e \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0443, \u0430 Control+Z \u0430\u0431\u043e Command+Z \u0441\u043a\u0430\u0441\u043e\u0432\u0443\u0454 \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043d\u043d\u044f (\u0434\u043e\u0434\u0430\u0439\u0442\u0435 Shift, \u0449\u043e\u0431 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0438 \u0434\u0456\u044e)."],"Subtitle editing workspace":["\u0420\u043e\u0431\u043e\u0447\u0438\u0439 \u043f\u0440\u043e\u0441\u0442\u0456\u0440 \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0456\u0432"],"Add a subtitle cue.":["\u0414\u043e\u0434\u0430\u0442\u0438 \u0442\u0438\u0442\u0440 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0456\u0432."],"No subtitle tracks have been added to this video yet.":["\u0414\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0432\u0456\u0434\u0435\u043e \u0449\u0435 \u043d\u0435 \u0434\u043e\u0434\u0430\u043d\u043e \u0436\u043e\u0434\u043d\u043e\u0457 \u0434\u043e\u0440\u0456\u0436\u043a\u0438 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0456\u0432."],"Paste transcript":["\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0440\u043e\u0437\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0443"],"Add track":["\u0414\u043e\u0434\u0430\u0442\u0438 \u0434\u043e\u0440\u0456\u0436\u043a\u0443"],"button: overwrite an already-published subtitle track\u0004Update":["\u041e\u043d\u043e\u0432\u0438\u0442\u0438"],"Save draft":["\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0447\u0435\u0440\u043d\u0435\u0442\u043a\u0443"],"Paste text":["\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442"],"Back to tracks":["\u041f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f \u0434\u043e \u0434\u043e\u0440\u0456\u0436\u043e\u043a"],"Loading subtitle content\u2026":["\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0432\u043c\u0456\u0441\u0442\u0443 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0456\u0432\u2026"],"Subtitle tracks":["\u0414\u043e\u0440\u0456\u0436\u043a\u0438 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0456\u0432"],"New subtitle track":["\u041d\u043e\u0432\u0430 \u0434\u043e\u0440\u0456\u0436\u043a\u0430 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0456\u0432"],"Edit subtitle track":["\u0420\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u0434\u043e\u0440\u0456\u0436\u043a\u0443 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0456\u0432"],"Upload subtitle file":["\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0444\u0430\u0439\u043b \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0456\u0432"],"Replace subtitle file":["\u0417\u0430\u043c\u0456\u043d\u0438\u0442\u0438 \u0444\u0430\u0439\u043b \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0456\u0432"],"Drop a subtitle file to upload":["\u041f\u0435\u0440\u0435\u0442\u044f\u0433\u043d\u0456\u0442\u044c \u0444\u0430\u0439\u043b \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0456\u0432, \u0449\u043e\u0431 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438"],"Manage subtitles for %s":["\u041a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0430\u043c\u0438 \u0434\u043b\u044f %s"],"Manage subtitles for %1$s: %2$s":["\u041a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0430\u043c\u0438 \u0434\u043b\u044f %1$s: %2$s"],"VideoPress video":["VideoPress \u0432\u0456\u0434\u0435\u043e"],"Delete the %s subtitle draft? This cannot be undone.":["\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0447\u0435\u0440\u043d\u0435\u0442\u043a\u0443 %s \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0456\u0432? \u0426\u044e \u0434\u0456\u044e \u043d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438."],"Delete the %s subtitle track? This cannot be undone.":["\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0434\u043e\u0440\u0456\u0436\u043a\u0443 %s \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0456\u0432? \u0426\u044e \u0434\u0456\u044e \u043d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438."],"Paste subtitle text before importing.":["\u0412\u0441\u0442\u0430\u0432\u0442\u0435 \u0442\u0435\u043a\u0441\u0442 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0456\u0432 \u043f\u0435\u0440\u0435\u0434 \u0456\u043c\u043f\u043e\u0440\u0442\u043e\u043c."],"Subtitle text imported.":["\u0422\u0435\u043a\u0441\u0442 \u0441\u0443\u0431\u0442