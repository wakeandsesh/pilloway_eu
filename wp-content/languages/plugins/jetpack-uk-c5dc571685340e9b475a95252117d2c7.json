56\u043c\u043d\u0430\u0442\u0456"],"Putting on my reading glasses":["\u041d\u0430\u0434\u044f\u0433\u0430\u044e \u043e\u043a\u0443\u043b\u044f\u0440\u0438 \u0434\u043b\u044f \u0447\u0438\u0442\u0430\u043d\u043d\u044f"],"Digging through the archives":["\u041d\u0438\u0448\u043f\u043e\u0440\u0438\u043c\u043e \u0432 \u0430\u0440\u0445\u0456\u0432\u0430\u0445"],"Rolling up my virtual sleeves":["\u0417\u0430\u043a\u043e\u0447\u0443\u044e \u0432\u0456\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u0456 \u0440\u0443\u043a\u0430\u0432\u0438"],"Expanding the search":["\u0420\u043e\u0437\u0448\u0438\u0440\u044e\u0454\u043c\u043e \u043f\u043e\u0448\u0443\u043a"],"Pulling in more context":["\u0417\u0430\u043b\u0443\u0447\u0430\u0454\u043c\u043e \u0431\u0456\u043b\u044c\u0448\u0435 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443"],"Gathering more details":["\u0417\u0431\u0438\u0440\u0430\u0454\u043c\u043e \u0431\u0456\u043b\u044c\u0448\u0435 \u0434\u0435\u0442\u0430\u043b\u0435\u0439"],"Analyzing additional sources":["\u0410\u043d\u0430\u043b\u0456\u0437\u0443\u0454\u043c\u043e \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0456 \u0434\u0436\u0435\u0440\u0435\u043b\u0430"],"Finding a more complete answer":["\u0428\u0443\u043a\u0430\u0454\u043c\u043e \u043f\u043e\u0432\u043d\u0456\u0448\u0443 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c"],"Looking deeper into this":["\u0414\u0438\u0432\u0438\u043c\u043e\u0441\u044f \u0433\u043b\u0438\u0431\u0448\u0435"],"Searching harder":["\u0428\u0443\u043a\u0430\u0454\u043c\u043e \u0440\u0435\u0442\u0435\u043b\u044c\u043d\u0456\u0448\u0435"],"Sorry, an error occurred while generating an answer.":["\u0412\u0438\u0431\u0430\u0447\u0442\u0435, \u043f\u0456\u0434 \u0447\u0430\u0441 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u0457 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043f\u043e\u043c\u0438\u043b\u043a\u0430."],"Articles":["\u0421\u0442\u0430\u0442\u0442\u0456"],"Popular Filters":["\u041f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u0456 \u0444\u0456\u043b\u044c\u0442\u0440\u0438"],"Search suggestions":["\u041f\u043e\u0448\u0443\u043a\u043e\u0432\u0456 \u043f\u0440\u043e\u043f\u043e\u0437\u0438\u0446\u0456\u0457"],"Finding an answer":["\u0428\u0443\u043a\u0430\u0454\u043c\u043e \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c\u2026"],"AI answer":["\u0412\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c \u0428\u0406"],"Suggestions":["\u041f\u0440\u043e\u043f\u043e\u0437\u0438\u0446\u0456\u0457"],"Open overlay from filter links":["\u0412\u0456\u0434\u043a\u0440\u0438\u0442\u0438 c\u043f\u043b\u0438\u0432\u0430\u044e\u0447\u0435 \u0432\u0456\u043a\u043d\u043e \u0437 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u044c \u0444\u0456\u043b\u044c\u0442\u0440\u0430"],"Open overlay when filters are used outside the Jetpack Sidebar":["\u0412\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0442\u0438 c\u043f\u043b\u0438\u0432\u0430\u044e\u0447\u0435 \u0432\u0456\u043a\u043d\u043e, \u043a\u043e\u043b\u0438 \u0444\u0456\u043b\u044c\u0442\u0440\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0435\u0436\u0430\u043c\u0438 \u0431\u0456\u0447\u043d\u043e\u0457 \u043f\u0430\u043d\u0435\u043b\u0456 Jetpack"],"Show post date":["\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u0438 \u0434\u0430\u0442\u0443 \u0437\u0430\u043f\u0438\u0441\u0443"],"Jetpack Search has encountered an error. Please contact the site administrator if the issue persists. [%s]":["Jetpack \u041f\u043e\u0448\u0443\u043a \u0432\u0438\u044f\u0432\u0438\u0432 \u043f\u043e\u043c\u0438\u043b\u043a\u0443. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430 \u0437\u0432\u0435\u0440\u043d\u0456\u0442\u044c\u0441\u044f \u0434\u043e \u0430\u0434\u043c\u0456\u043d\u0456\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0430 \u0441\u0430\u0439\u0442\u0443, \u044f\u043a\u0449\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u043d\u0435 \u0437\u043d\u0438\u043a\u043d\u0435. [%s]"],"Jetpack Search is currently unavailable. Please try again later. [%s]":["Jetpack \u041f\u043e\u0448\u0443\u043a \u043d\u0430\u0440\u0430\u0437\u0456 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439. \u0411\u0443\u0434\u044c-\u043b\u0430\u0441\u043a\u0430 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u043f\u0456\u0437\u043d\u0456\u0448\u0435. [%s]"],"Open when user submits the form (recommended)":["\u0412\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0442\u0438, \u043a\u043e\u043b\u0438 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0454 \u0444\u043e\u0440\u043c\u0443 (\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043e)"],"Magnifying Glass":["\u0417\u0431\u0456\u043b\u044c\u0448\u0443\u0432\u0430\u043b\u044c\u043d\u0435 \u0441\u043a\u043b\u043e"],"Matches content":["\u0417\u0431\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u0456\u0437 \u0432\u043c\u0456\u0441\u0442\u043e\u043c"],"Matches comments":["\u0417\u0431\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u0437 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u044f\u043c\u0438"],"Show preview":["\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u0438 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u0439 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434"],"You must leave at least one post type unchecked.":["\u0412\u0438 \u043f\u043e\u0432\u0438\u043d\u043d\u0456 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043f\u0440\u0438\u043d\u0430\u0439\u043c\u043d\u0456 \u043e\u0434\u0438\u043d \u0442\u0438\u043f \u0437\u0430\u043f\u0438\u0441\u0443 \u043d\u0435\u0432\u0456\u0434\u043c\u0456\u0447\u0435\u043d\u0438\u043c."],"Excluded post types":["\u0412\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0456 \u0442\u0438\u043f\u0438 \u0437\u0430\u043f\u0438\u0441\u0456\u0432"],"Loading\u2026":["\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\