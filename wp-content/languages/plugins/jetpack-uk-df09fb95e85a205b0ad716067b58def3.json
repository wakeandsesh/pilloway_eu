f \u0440\u043e\u0437\u0442\u0430\u0448\u043e\u0432\u0430\u043d\u0456 \u043d\u0430 \u0431\u0456\u0447\u043d\u0456\u0439 \u043f\u0430\u043d\u0435\u043b\u0456 \u043f\u0440\u0430\u0432\u043e\u0440\u0443\u0447."],"Make each field yours":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0439\u0442\u0435 \u043a\u043e\u0436\u043d\u0435 \u043f\u043e\u043b\u0435 \u043f\u0456\u0434 \u0441\u0435\u0431\u0435"],"Start from a template like Contact, RSVP, or Registration, then add extra fields from the inserter. Everything you add lands inside the form automatically.":["\u041f\u043e\u0447\u043d\u0456\u0442\u044c \u0456\u0437 \u0448\u0430\u0431\u043b\u043e\u043d\u0443, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 \u00ab\u041a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u0430 \u0444\u043e\u0440\u043c\u0430\u00bb, \u00ab\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f \u0443\u0447\u0430\u0441\u0442\u0456\u00bb \u0430\u0431\u043e \u00ab\u0420\u0435\u0454\u0441\u0442\u0440\u0430\u0446\u0456\u044f\u00bb, \u0430 \u043f\u043e\u0442\u0456\u043c \u0434\u043e\u0434\u0430\u0439\u0442\u0435 \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0456 \u043f\u043e\u043b\u044f \u0447\u0435\u0440\u0435\u0437 \u043f\u0430\u043d\u0435\u043b\u044c \u0432\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044f. \u0423\u0441\u0435, \u0449\u043e \u0432\u0438 \u0434\u043e\u0434\u0430\u0454\u0442\u0435, \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0440\u043e\u0437\u043c\u0456\u0449\u0443\u0454\u0442\u044c\u0441\u044f \u0443 \u0444\u043e\u0440\u043c\u0456."],"Add fields":["\u0414\u043e\u0434\u0430\u0442\u0438 \u043f\u043e\u043b\u044f"],"You\u2019re building a reusable form. Create it once here, then add it to any page or post on your site.":["\u0412\u0438 \u0441\u0442\u0432\u043e\u0440\u044e\u0454\u0442\u0435 \u0431\u0430\u0433\u0430\u0442\u043e\u0440\u0430\u0437\u043e\u0432\u0443 \u0444\u043e\u0440\u043c\u0443. \u0421\u0442\u0432\u043e\u0440\u0456\u0442\u0