"{extra}\n"
"{page_url}"

#. translators: Telegram message template. Keep the {tags} as-is — they are
#. replaced with product data.
#: includes/Core/Installer.php:105
msgid ""
"⚠️ <b>Low stock</b>\n"
"{product_name}\n"
"SKU: {product_sku}\n"
"Remaining: <b>{stock_qty}</b>"
