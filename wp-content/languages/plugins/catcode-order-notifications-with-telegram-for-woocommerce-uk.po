"📩 <b>{type}</b>\n"
"👤 {name}\n"
"📞 {phone}\n"
"✉️ {email}\n"
"📦 {product}\n"
"🔖 SKU: {product_sku}\n"
"📝 {comment}\n"
"{extra}\n"
"{page_url}"
