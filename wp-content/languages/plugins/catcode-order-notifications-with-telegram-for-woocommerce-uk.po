#: includes/Admin/SettingsPage.php:104
msgid "Instant notifications about site form submissions to a Telegram chat, group or topic."
msgstr "Миттєві повідомлення про заявки з форм сайту у Telegram-чат, групу або тему."

#: catcode-order-notifications-with-telegram-for-woocommerce.php:123
msgid "Telegram Notifications: neither WooCommerce nor a form source (Contact Form 7) was found, so nothing will be sent yet."
msgstr "Telegram-сповіщення: не знайдено ані WooCommerce, ані джерела заявок (Contact Form 7) — поки що нічого не надсилатиметься."

#. Description of the plugin
#: catcode-order-notifications-with-telegram-for-woocommerce.php
msgid "Instant Telegram notifications for WooCommerce orders and site form leads: new orders, status changes, failed payments, low stock, Contact Form 7. WooCommerce is optional. Flexible message templates, multiple chats and topics, and a delivery log."
msgstr "Миттєві сповіщення в Телеграм про замовлення WooCommerce і заявки з форм сайту: нові замовлення, зміна статусу, невдалі оплати, закінчення залишків, Contact Form 7. WooCommerce не обов'язковий. Гнучкі шаблони повідомлень, кілька чатів і тем, журнал доставки."

#. translators: Telegram message template. Keep the {tags} as-is — they are
#. replaced with order data.
#: includes/Core/Installer.php:131
msgid ""
"🛒 <b>New order {order_number}</b>\n"
"👤 {customer_name}\n"
"📞 {customer_phone}\n"
"💳 {payment_method}\n"
"🚚 {shipping_method}\n"
"📍 {shipping_address}\n"
"\n"
"{items}\n"
"💰 Total: <b>{order_total}</b>\n"
"📝 {customer_note}\n"
"{admin_url}"
msgstr ""
"🛒 <b>Нове замовлення {order_number}</b>\n"
"👤 {customer_name}\n"
"📞 {customer_phone}\n"
"💳 {payment_method}\n"
"🚚 {shipping_method}\n"
"📍 {shipping_address}\n"
"\n"
"{items}\n"
"💰 Разом: <b>{order_total}</b>\n"
"📝 {customer_note}\n"
"{admin_url}"

#. translators: Telegram message template. Keep the {tags} as-is — they are
#. replaced with form data.
#: includes/Core/Installer.php:115
